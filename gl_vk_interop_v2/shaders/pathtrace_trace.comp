// unpolarised Fresnel reflectance of a smooth dielectric interface

// path-traced water the reflection half of a water surface the camera sees (see main())
bool particleSpriteCandidate(rayQueryEXT rq, out vec3 emission) {
    emission = vec3(0.0);
    int id = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false);
    if (id < 0 || id >= materials.length()) return false;
    MaterialEntry m = materials[id];
    if (m.vertexAddr == 0ul || m.indexAddr == 0ul) return false;
    uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
    VertexBuf vb = VertexBuf(m.vertexAddr);
    IndexBuf ib = IndexBuf(m.indexAddr);
    uint i0 = ib.i[prim * 3u + 0u];
    if (vb.v[i0].materialIndex != PARTICLE_MATERIAL) return false;
    uint i1 = ib.i[prim * 3u + 1u], i2 = ib.i[prim * 3u + 2u];
    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, false);
    vec2 uv = vb.v[i0].uv * (1.0 - bc.x - bc.y) + vb.v[i1].uv * bc.x + vb.v[i2].uv * bc.y;
    vec4 t = textureLod(uMapTextures[nonuniformEXT(vb.v[i0].textureIndex)], uv, 0.0);
    // radial sprites (explosion discs, tangent.x = 1)
    if (vb.v[i0].tangent.x > 0.5) t.a *= 1.0 - smoothstep(0.25, 0.5, length(uv - 0.5));
    emission = pow(max(t.rgb * vb.v[i0].normal, vec3(0.0)), vec3(2.2)) * t.a * (4.0 * p.particleParams.x);
    return true;
}
// the sprites a ray passes before its hit (tMax)
vec3 spritesAlong(vec3 origin, vec3 dir, float tMin, float tMax) {
    rayQueryEXT sq;
    rayQueryInitializeEXT(sq, uTlas, gl_RayFlagsNoOpaqueEXT, RAYMASK_PARTICLE, origin, tMin, dir, tMax);
    vec3 sum = vec3(0.0);
    while (rayQueryProceedEXT(sq)) {
        if (rayQueryGetIntersectionTypeEXT(sq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        vec3 e;
        if (particleSpriteCandidate(sq, e)) sum += e;
    }
    return sum;
}

float hgPhase(float cosT, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * cosT, 1e-4), 1.5));
}
// horizontal drift per unit depth of light refracted into the water at xy
vec2 waterRefractDrift(vec2 xy, vec3 dIn) {
    vec3 n = waterWaveNormalAt(xy, p.waterFft, p.waterMap, waterAmp(), 1.0);
    vec3 t = refract(dIn, n, 1.0 / IOR_WATER);
    return t.z < -1e-3 ? t.xy / -t.z : vec2(0.0);
}
// light concentration h units below surface point s
float waterFocusing(vec2 s, vec3 dIn, float h) {
    if (p.waterVolume.z <= 0.0 || p.waterWave.w < 0.5) return 1.0;
    float e = clamp(0.25 + h * 0.01, 0.25, 8.0);
    vec2 ddx = (waterRefractDrift(s + vec2(e, 0.0), dIn) - waterRefractDrift(s - vec2(e, 0.0), dIn)) / (2.0 * e);
    vec2 ddy = (waterRefractDrift(s + vec2(0.0, e), dIn) - waterRefractDrift(s - vec2(0.0, e), dIn)) / (2.0 * e);
    mat2 J = mat2(1.0) + h * mat2(ddx, ddy);
    float f = min(1.0 / max(abs(determinant(J)), 0.125), 8.0);
    return mix(1.0, f, p.waterVolume.z);
}
vec3 waterLightThroughSurface(vec3 x, float surfaceZ, vec3 sigma, vec3 dIn, vec3 lightPos, bool atInfinity, out vec3 toLight, out float pathLen) {
    toLight = vec3(0.0, 0.0, 1.0);
    pathLen = 0.0;
    vec3 t0 = refract(dIn, vec3(0.0, 0.0, 1.0), 1.0 / IOR_WATER);
    if (t0.z > -1e-3) return vec3(0.0);
    float h = surfaceZ - x.z;
    float upLen = h / -t0.z;
    toLight = -t0;
    vec3 s = x - t0 * upLen;
    // underwater leg (absorbed to the surface)
    gShadowWaterSigma = sigma;
    gShadowWaterSurfaceZ = surfaceZ;
    vec3 v = traceShadowRayTinted(x, -t0, upLen + 0.5);
    gShadowWaterSigma = vec3(0.0);
    if (dot(v, v) <= 0.0) return vec3(0.0);
    // above-water leg
    vec3 s2 = vec3(s.xy, surfaceZ + 0.05);
    vec3 up = atInfinity ? -dIn : lightPos - s2;
    float upDist = atInfinity ? 4096.0 : length(up);
    if (!atInfinity) up /= max(upDist, 1e-4);
    v *= traceShadowRayTinted(s2, up, atInfinity ? upDist : max(upDist - 0.5, 0.0));
    if (dot(v, v) <= 0.0) return vec3(0.0);
    pathLen = upLen + (atInfinity ? 0.0 : upDist);
    float Tfres = 1.0 - fresnelDielectric(clamp(-dIn.z, 0.0, 1.0), 1.0, IOR_WATER);
    return v * Tfres * waterFocusing(s.xy, dIn, h);
}
vec3 waterVolumeInscatter(vec3 o, vec3 dir, float segLen, vec3 sigma, float surfaceZ, inout uint seed) {
    if (p.waterVolume.x <= 0.0 || segLen <= 1e-3) return vec3(0.0);
    float sBar = max((sigma.r + sigma.g + sigma.b) / 3.0, 1e-5);
    float L = min(segLen, 12.0 / sBar);  // past e^-12 nothing comes back
    float norm = 1.0 - exp(-sBar * L);
    float t = -log(1.0 - randFloat(seed) * norm) / sBar;
    float pdf = sBar * exp(-sBar * t) / max(norm, 1e-8);
    vec3 x = o + dir * t;
    if (surfaceZ - x.z <= 0.05) return vec3(0.0);
    const float savedCaustic = gShadowWaterCaustic;
    gShadowWaterCaustic = 0.0;  // the water surface transmits here, no photon handoff

    bool hasSun = dot(p.sunColorPad.xyz, p.sunColorPad.xyz) > 0.0;
    uint lightCount = p.frameData.w;
    bool hasLights = lightCount > 0u;
    bool pickSun = hasSun && (!hasLights || randFloat(seed) < 0.5);
    float pickScale = (hasSun && hasLights) ? 2.0 : 1.0;
    vec3 Li = vec3(0.0), toLight = vec3(0.0, 0.0, 1.0);
    float pathLen;
    if (pickSun) {
        vec3 dIn = normalize(p.sunDirectionRadius.xyz);  // direction sunlight travels
        Li = p.sunColorPad.xyz * SAUER_LIGHTMAP_OVERBRIGHT * waterLightThroughSurface(x, surfaceZ, sigma, dIn, vec3(0.0), true, toLight, pathLen);
    } else if (hasLights) {
        // one point light, picked by its unshadowed strength here
        LightList ll = lightListAt(vec3(x.xy, surfaceZ), lightCount);
        uint n = lightListSize(ll);
        float total = 0.0;
        for (uint k = 0u; k < n; ++k) {
            uint li = lightListGet(ll, k);
            if (li >= lightCount) continue;
            float d = length(lightNearestPoint(lights[li].posRadius.xyz, lightHalfAxis(lights[li].colorFlags, lights[li].reserved), x) - x);
            bool noFalloff = (int(lights[li].colorFlags.w + 0.5) & 2) != 0;
            if (!noFalloff && d >= lights[li].posRadius.w) continue;
            total += luminance(lights[li].colorFlags.xyz) * (noFalloff ? 1.0 : 1.0 - d / lights[li].posRadius.w);
        }
        if (total > 0.0) {
            float u = randFloat(seed) * total, acc = 0.0, wPick = 0.0;
            uint pick = 0xFFFFFFFFu;
            for (uint k = 0u; k < n; ++k) {
                uint li = lightListGet(ll, k);
                if (li >= lightCount) continue;
                float d = length(lightNearestPoint(lights[li].posRadius.xyz, lightHalfAxis(lights[li].colorFlags, lights[li].reserved), x) - x);
                bool noFalloff = (int(lights[li].colorFlags.w + 0.5) & 2) != 0;
                if (!noFalloff && d >= lights[li].posRadius.w) continue;
                float w = luminance(lights[li].colorFlags.xyz) * (noFalloff ? 1.0 : 1.0 - d / lights[li].posRadius.w);
                acc += w; pick = li; wPick = w;
                if (u < acc) break;
            }
            if (pick != 0xFFFFFFFFu && wPick > 0.0) {
                pickScale *= total / wPick;
                vec3 lp = lightNearestPoint(lights[pick].posRadius.xyz, lightHalfAxis(lights[pick].colorFlags, lights[pick].reserved), x);
                float radius = lights[pick].posRadius.w;
                int flagBits = int(lights[pick].colorFlags.w + 0.5);
                bool noFalloff = (flagBits & 2) != 0;
                vec3 col = lights[pick].colorFlags.xyz * ((flagBits & 1) != 0 ? 1.0 : SAUER_LIGHTMAP_OVERBRIGHT);
                if (lp.z > surfaceZ + 0.1) {
                    // above the water
                    vec3 straight = normalize(lp - x);
                    vec3 s0 = x + straight * waterPlaneT(x, straight, surfaceZ);
                    vec3 dIn = normalize(s0 - lp);
                    vec3 v = waterLightThroughSurface(x, surfaceZ, sigma, dIn, lp, false, toLight, pathLen);
                    float atten = (noFalloff ? 1.0 : max(1.0 - pathLen / radius, 0.0)) * lightFacing(pick, dIn);
                    Li = col * atten * v;
                } else {
                    // under the water too
                    float d = length(lp - x);
                    toLight = (lp - x) / max(d, 1e-4);
                    gShadowWaterSigma = sigma;
                    gShadowWaterSurfaceZ = surfaceZ;
                    vec3 v = traceShadowRayTinted(x, toLight, max(d - max(lightShadowGap(lights[pick].colorFlags, lights[pick].reserved), 0.04), 0.0));
                    gShadowWaterSigma = vec3(0.0);
                    float atten = (noFalloff ? 1.0 : max(1.0 - d / radius, 0.0)) * lightFacing(pick, -toLight);
                    Li = col * atten * v;
                }
            }
        }
    }
    gShadowWaterCaustic = savedCaustic;
    if (dot(Li, Li) <= 0.0) return vec3(0.0);
    vec3 Tcam = exp(-sigma * t);
    return Tcam * (p.waterVolume.x * hgPhase(dot(toLight, dir), p.waterVolume.y) * SAUER_BRDF_PI_COMPENSATION / pdf) * Li * pickScale;
}

vec3 waterReflectionSurface(rayQueryEXT rq, vec3 dir, bool reflMissed, inout uint seed);
vec3 waterReflectionRadiance(vec3 origin, vec3 dir, inout uint seed) {
    rayQueryEXT rq;
    const bool sprites = p.particleParams.x > 0.0 && p.particleParams.y > 0.5;
    rayQueryInitializeEXT(rq, uTlas, 0u, RAYMASK_WORLD, origin + dir * 0.02, 0.0015, dir, 4096.0);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue; if (waterPatchHides(rq)) continue;  // displaced water patch
        bool alphaTestPassed;
        MaterialEntry unusedEntry;
        if (resolveAlphaTestCandidate(rq, alphaTestPassed, unusedEntry)) {
            if (alphaTestPassed) rayQueryConfirmIntersectionEXT(rq);
            continue;
        }
        rayQueryConfirmIntersectionEXT(rq);
    }
    gRayStat[6]++;
    const bool reflMissed = rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT;
    vec3 spriteL = sprites ? spritesAlong(origin + dir * 0.02, dir, 0.0015, reflMissed ? 4096.0 : rayQueryGetIntersectionTEXT(rq, true)) : vec3(0.0);
    return spriteL + waterReflectionSurface(rq, dir, reflMissed, seed);
}
vec3 waterReflectionSurface(rayQueryEXT rq, vec3 dir, bool reflMissed, inout uint seed) {
    if (reflMissed) {
        vec3 L = sampleRealSky(dir);
        if (dot(p.sunColorPad.xyz, p.sunColorPad.xyz) > 0.0) {
            float ar = max(p.sunDirectionRadius.w, 1e-4);
            if (dot(dir, normalize(-p.sunDirectionRadius.xyz)) >= cos(ar))
                L += p.sunColorPad.xyz / max(PI * ar * ar, 1e-8) * SAUER_LIGHTMAP_OVERBRIGHT * SAUER_BRDF_PI_COMPENSATION;
        }
        return L;
    }
    vec3 hp, hn, ha, he;
    float hs, hss, hta, hm, hwr, hcw;
    bool hg, hw, hen;
    if (!fetchHitAttributes(rq, hp, hn, ha, hs, hss, he, hta, hm, hg, hw, hwr, hen, 0.0, p.emissiveImportancePad.y, hcw)) return vec3(0.0);
    vec3 floorL = ha * p.ambientFloorPad.xyz * SAUER_LIGHTMAP_OVERBRIGHT;
    if (hg) return floorL;  // glass/water seen in the reflection
    float hitRoughOverride = gHitRoughOverride;
    float rough = surfaceRoughness(hs * hss, hitRoughOverride);
    rough = mix(rough, min(rough, 0.02), hm);
    vec3 F0 = mix(DIELECTRIC_F0, ha, hm);
    gSpecWeight = ((hs * hss > 0.001 || hm > 0.001 || hitRoughOverride >= 0.0) ? 1.0 : clamp(p.skyRotationPad.w, 0.0, 1.0)) * gHitSpecWeight;
    vec3 lmIrr;
    gNoContinuation = true;
    vec3 direct = directLighting(hp, hn, -dir, ha, F0, rough, hm, seed, lmIrr);
    gNoContinuation = false;
    return max(he + direct, floorL);
}

// RR moves a reflection by these, not by the surface's motion
float specularVirtualDistance(vec3 cameraPos, vec3 worldPos, vec3 N, float primaryDist) {
    vec3 V = normalize(worldPos - cameraPos);
    if (dot(N, V) > 0.0) N = -N;  // face the camera (under-water / back faces)
    vec3 R = reflect(V, N);
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTlas, gl_RayFlagsOpaqueEXT, 0x7F, worldPos + N * 0.02, 0.0, R, 4096.0);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return 60000.0;
    return min(primaryDist + rayQueryGetIntersectionTEXT(rq, true), 59000.0);
}

void main() {
    ivec2 size = imageSize(uRawRadiance);
#ifdef PT_RAYGEN
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
#else
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
#endif
    if (pixel.x >= size.x || pixel.y >= size.y) return;
#ifdef PT_SER_TOP
    SER_REORDER(0u, 1u);  // one reorder before anything else
#endif
#ifdef PT_SER_MIN
    imageStore(uRawRadiance, pixel, vec4(0.0, 0.0, 0.0, 1.0)); return;  // reorder, then nothing
#endif
#ifdef PT_SER_RQ
    {  // reorder, then one bare ray query from the camera
        vec3 camP = (p.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
        vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
        vec4 fp = p.invViewProj * vec4(ndc, 1.0, 1.0);
        vec3 d = normalize(fp.xyz / fp.w - camP);
        rayQueryEXT dq;
#ifdef PT_SER_CAND
        rayQueryInitializeEXT(dq, uTlas, 0u, 0x7Fu, camP, 0.0, d, 4096.0);  // non-opaque
        while (rayQueryProceedEXT(dq)) {
#ifdef PT_SER_ALPHA
            if (rayQueryGetIntersectionTypeEXT(dq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue; if (waterPatchHides(dq)) continue;
            bool atp; MaterialEntry unusedE;
            if (resolveAlphaTestCandidate(dq, atp, unusedE)) { if (atp) rayQueryConfirmIntersectionEXT(dq); continue; }
            rayQueryConfirmIntersectionEXT(dq);
#else
            if (rayQueryGetIntersectionTypeEXT(dq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) rayQueryConfirmIntersectionEXT(dq);
#endif
        }
#else
        rayQueryInitializeEXT(dq, uTlas, gl_RayFlagsOpaqueEXT, 0xFFu, camP, 0.0, d, 4096.0);
        while (rayQueryProceedEXT(dq)) {}
#endif
        float t = rayQueryGetIntersectionTypeEXT(dq, true) != gl_RayQueryCommittedIntersectionNoneEXT ? rayQueryGetIntersectionTEXT(dq, true) : 0.0;
#ifdef PT_SER_FETCH
        vec3 hitPos, hitN, hitAlbedo, hitEmission;
        float hs, hss, hta, hm, hwt, hcw;
        bool hg, hw, he;
        if (t > 0.0 && fetchHitAttributes(dq, hitPos, hitN, hitAlbedo, hs, hss, hitEmission, hta, hm, hg, hw, hwt, he, 0.0, 0.0, hcw)) {
#ifdef PT_SER_PREV
            vec3 prevWP;
            if (fetchPrimaryPrevWorldPos(dq, prevWP)) hitAlbedo += prevWP * 1e-6;
#endif
            imageStore(uRawRadiance, pixel, vec4(hitAlbedo, 1.0));
        }
        else
#endif
        imageStore(uRawRadiance, pixel, vec4(vec3(t / 1000.0), 1.0));
        return;
    }
#endif
    PROF_START();
    // blue noise
    gPixel = pixel;

    vec3 cameraPos = (p.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

    vec3 worldPos, normal, albedo, primaryEmission;
    float specIntensity, specScale, rawDepth, metalness;
    // linear distance from the camera to this pixel's primary hit
    float linearDist;
    bool primaryIsGlass, primaryIsWater, primaryEntering;
    // animated water
    float primaryWaterRefThickness;
    // the ray-cone width at the primary hit, carried forward below as the starting width for the first
    // bounce ray
    float coneWidth;
    bool primaryIsDynamic;
    bool primaryHit = reconstructPrimary(pixel, size, cameraPos, worldPos, normal, albedo, specIntensity, specScale, primaryEmission, rawDepth, metalness, primaryIsGlass, primaryIsWater, primaryWaterRefThickness, primaryEntering, coneWidth, primaryIsDynamic, linearDist);
    PROF_LAP(1);
    if (!primaryHit) {
        // sky / no geometry nothing to shade except the skybox itself
        {
            vec2 missUv = (vec2(pixel) + 0.5) / vec2(size);
            vec4 missClipFar = vec4(missUv * 2.0 - 1.0, 1.0, 1.0);
            vec4 missWorldFar4 = p.invViewProj * missClipFar;
            vec3 missWorldFar = missWorldFar4.xyz / missWorldFar4.w;
            vec3 missRayDir = normalize(missWorldFar - cameraPos);
            imageStore(uRawRadiance, pixel, vec4(sampleRealSky(missRayDir), 1.0));
        }
        imageStore(uLinearDepthOut, pixel, vec4(linearDist, 0.0, 0.0, 0.0));
        gRayStat[9]++;
        PROF_LAP(14);
        PROF_FINISH();
        flushRayStats();
        return;
    }

    // primary hit's model env-reflection (see gHitEnvRefl)
#ifdef PT_SER_PRIMARY
    imageStore(uRawRadiance, pixel, vec4(albedo, rawDepth)); return;  // reorder, primary hit, stop (rest compiled out)
#endif
    const uint ptCut = perfCutValue();
    if (ptCut == 1u) {
        imageStore(uRawRadiance, pixel, vec4(albedo, primaryIsDynamic ? -rawDepth : rawDepth));
        imageStore(uLinearDepthOut, pixel, vec4(linearDist, 0.0, 0.0, 0.0));
        flushRayStats();
        return;
    }
    float primaryEnvRefl = gHitEnvRefl;
    float primaryRoughOverride = gHitRoughOverride;  // roughness override
    float primarySpecWeight = gHitSpecWeight;
    bool primaryEmissiveModel = gHitModelEmission;
    bool primaryIsGrass = gHitIsGrass;  // path-traced grass
    // dlss-rr specular motion vectors
    float specVirtualDist = 0.0;
    if (!primaryIsGrass) {
        float primaryRough = surfaceRoughness(specIntensity * specScale, primaryRoughOverride);
        bool mirrorLike = primaryIsWater || primaryIsGlass || metalness > 0.5 || primaryEnvRefl > 0.0;
        if (p.rrParams.x > 0.5 ? (mirrorLike || primaryRough < 0.5) : (mirrorLike || primaryRough < 0.25))
        {
            PROF_LAP(8);
            specVirtualDist = specularVirtualDistance(cameraPos, worldPos, normal, linearDist);
            PROF_LAP(7);
        }
    }

    // trace this many full paths from the shared primary hit and average them
    uint sppCount = clamp(p.frameData.y >> 16u, 1u, 64u);
    vec3 radianceAccum = vec3(0.0);
    // what the camera path's first underwater segment did, see the imageStore below
    vec3 waterDebug = vec3(-1.0);
    float fogLinearDist = linearDist;  // see deltaChain, glass pixels report the distance through the glass
    for (uint sampleIdx = 0u; sampleIdx < sppCount; ++sampleIdx) {
    gSample = sampleIdx;
    uint seed = pcgHash(uint(pixel.x) * 1973u ^ pcgHash(uint(pixel.y) * 9277u ^ pcgHash(p.frameData.x * 26699u + 1u + sampleIdx * 0x9E3779B9u)));

    vec3 radiance = primaryEmission;
    vec3 throughput = vec3(1.0);
    vec3 curPos = worldPos;
    vec3 curNormal = normal;
    vec3 curAlbedo = albedo;
    float curSpecIntensity = specIntensity;
    float curSpecScale = specScale;
    float curMetalness = metalness;
    float curEnvRefl = primaryEnvRefl;
    float curRoughOverride = primaryRoughOverride;
    float curSpecWeight = primarySpecWeight;
    bool curEmissiveModel = primaryEmissiveModel;
    bool curIsGrass = primaryIsGrass;
    bool curIsGlass = primaryIsGlass;
    // vertices this path shades, written back at its end
    bool rcOn = p.cacheParams.x > 0.5;
    // an update path goes a bounce deeper than the rest, and a warp waits for its slowest lane
    const bool rcCoherent = (uint(p.cacheParams2.w + 0.5) & 2u) != 0u;
    const uvec2 rcKeyPx = rcCoherent ? uvec2(uint(pixel.x) >> 3u, uint(pixel.y) >> 2u) : uvec2(pixel);
    bool rcUpdatePath = rcOn && (pcgHash(rcKeyPx.x * 7919u ^ pcgHash(rcKeyPx.y * 104729u ^ p.frameData.x * 2654435761u ^ sampleIdx)) % max(uint(p.cacheParams.w), 1u)) == 0u;
    uint rcSlot[4], rcCheck[4];
    vec3 rcBefore[4], rcT[4];
    uint rcCount = 0u;
    bool curIsDynamic = primaryIsDynamic;
    vec3 diagRadAtDeep = vec3(-1.0);  // see gRayStat
    // transport albedo viewChain
    bool viewChain = true;
    vec3 curDisplayToTransport = primaryIsGlass ? vec3(1.0) : displayToTransportRatio(albedo);
    // animated water
    bool curIsWater = primaryIsWater;
    float curWaterRefThickness = primaryWaterRefThickness;
    bool curEntering = primaryEntering;
    vec3 primaryAlbedo = albedo;
    vec3 prevDir = normalize(worldPos - cameraPos);  // the primary camera ray's own direction, for the very first V below
    // constant spread angle across every bounce
    float coneSpreadAngle = p.emissiveImportancePad.y;

    bool primaryEscapedToSky = false;
    // true while every bounce so far was a delta (glass/water) pick
    bool deltaChain = true;
    bool glassFogDone = !primaryIsGlass;
    float glassFogDist = linearDist;
    vec3 floorAlbedo = primaryIsGlass ? vec3(0.0) : albedo * (1.0 - primaryEnvRefl);
    vec3 curLmIrradiance = vec3(0.0);

    // glass state
    bool insideGlass = false;
    // water fades toward its colour with depth
    bool glassMediumIsWater = false;
    vec3 glassEntryPos = vec3(0.0);
    vec3 glassTint = vec3(1.0);
    const float GLASS_REFERENCE_THICKNESS = 8.0;
    float glassReferenceThickness = GLASS_REFERENCE_THICKNESS;

    uint bounces = p.frameData.y & 0xFFFFu;
    const uint GLASS_BOUNCE_HEADROOM = 6u;
    // path-traced water medium state, see waterSigma()
    bool inWater = p.waterParams.x > 0.5;
    bool waterSinceDiffuse = false;  // refracted through a water surface since the last diffuse bounce
    bool pathSpread = false;
    vec3 misPos = vec3(0.0);
    float misPdfBsdf = 0.0;
    vec3 mediumSigma = inWater ? waterSigma(p.waterCamera.rgb, p.waterCamera.w) : vec3(0.0);
    vec3 mediumScatter = inWater ? waterScatterRadiance(p.waterCamera.rgb) : vec3(0.0);
    float mediumSurfaceZ = p.waterParams2.y;  // height of the surface the path's water was entered through
    if (inWater) {
        vec3 camDir = normalize(worldPos - cameraPos);
        float camSeg = min(linearDist, waterPlaneT(cameraPos, camDir, mediumSurfaceZ));
        vec3 T = exp(-mediumSigma * camSeg);
        radiance = radiance * T + (vec3(1.0) - T) * mediumScatter;
        radiance += waterVolumeInscatter(cameraPos, camDir, camSeg, mediumSigma, mediumSurfaceZ, seed);  // underwater volumetrics
        throughput *= T;
    }
    for (uint bounce = 0u; bounce <= bounces + GLASS_BOUNCE_HEADROOM; ++bounce) {
        PROF_LAP(bounce == 0u ? 8 : 12);
        gBounce = bounce;
        if (bounce == 3u) diagRadAtDeep = radiance;
        if (curIsGlass && !curIsWater) {
            if (!curEntering && !insideGlass) curEntering = true;
        } else if (!curIsGlass && insideGlass && !glassMediumIsWater) {
            throughput *= clamp(glassTint, vec3(0.02), vec3(1.0));
            insideGlass = false;
        }
        if (bounce == 0u && !curIsGlass) gRayStat[15] += uint(clamp(luminance(curAlbedo), 0.0, 4.0) * 256.0);  // camera-seen albedo
        curLmIrradiance = vec3(0.0);  // refilled by directLighting() for this vertex
        vec3 V = -prevDir;

        if (bounce == 1u) { gRayStat[16]++; if (rcOn && rcUpdatePath) gRayStat[18]++; }
        if (rcOn && !curIsGlass && !curIsDynamic && !inWater) {
            if (pathSpread && bounce >= (rcUpdatePath ? 2u : 1u)) {
                vec3 jt, jb;
                buildBasis(curNormal, jt, jb);
                float cellHere = max(p.cacheParams.y, 0.25) * float(1 << clamp(int(floor(log2(max(length(curPos - cameraPos), 1.0) / 32.0))), 0, 10));
                vec3 jp = curPos + (jt * (randFloat(seed) - 0.5) + jb * (randFloat(seed) - 0.5)) * cellHere;
                uint s0, ck;
                rcCell(jp, curNormal, cameraPos, s0, ck);
                int sl = rcFind(s0, ck);
                bool cacheOk = sl >= 0 && rcRadiance[sl].w >= p.cacheParams2.y && finite3(rcRadiance[sl].rgb);
                if (!cacheOk && (uint(p.cacheParams2.w + 0.5) & 1u) != 0u) {
                    rcCell(curPos, curNormal, cameraPos, s0, ck);
                    sl = rcFind(s0, ck);
                    cacheOk = sl >= 0 && rcRadiance[sl].w >= 1.0 && finite3(rcRadiance[sl].rgb);
                }
                if (cacheOk) {
                    radiance += throughput * rcRadiance[sl].rgb / curDisplayToTransport;
                    if (bounce == 1u) gRayStat[17]++;
                    break;
                }
                if (bounce == 1u) gRayStat[19]++;
            }
            bool diffuseHere = curSpecIntensity * curSpecScale < 0.15 && curMetalness < 0.1 && curEnvRefl < 0.05 && (curRoughOverride < 0.0 || curRoughOverride > 0.6);
            if (rcCount < 4u && (bounce > 0u || diffuseHere)) {
                rcCell(curPos, curNormal, cameraPos, rcSlot[rcCount], rcCheck[rcCount]);
                rcBefore[rcCount] = radiance;
                rcT[rcCount] = throughput / curDisplayToTransport;  // stored as transport-albedo light
                ++rcCount;
            }
        }

        vec3 bounceDir;
        vec3 throughputMul = vec3(1.0);
        float pdfBsdf = 0.0;
        // true whenever this bounce's new direction comes from a delta-like sampling strategy
        bool sampledDelta = false;
        // mirror-like continuations (glass/water, and glossy reflections close to the mirror
        // direction) see sprites
        bool spriteRay = false;

        if (curIsGlass) {
            // dielectric interface
            if (bounce == bounces + GLASS_BOUNCE_HEADROOM) break;

            if (curIsWater) {
                // medium handled by inWater, below
            } else if (curEntering) {
                insideGlass = true;
                glassMediumIsWater = curIsWater;
                glassEntryPos = curPos;
                glassTint = curAlbedo;
                glassReferenceThickness = curIsWater
                    ? curWaterRefThickness
                    : GLASS_REFERENCE_THICKNESS * mix(1.0, 4.0, clamp(p.emissiveImportancePad.w, 0.0, 1.0));
            } else if (insideGlass) {
                // colored absorption
                float dist = length(curPos - glassEntryPos);
                vec3 safeTint = clamp(glassTint, vec3(0.02), vec3(1.0));
                vec3 transmittance = glassMediumIsWater
                    ? mix(vec3(1.0), safeTint, clamp(dist / glassReferenceThickness, 0.0, 1.0))
                    : safeTint;
                throughput *= transmittance;
                insideGlass = false;
            }

            // same dielectric BSDF, selected per-hit IOR
            if (curIsWater && curEntering && bounce == 0u) {
                // path-traced water, the surface the camera sees
                float F = fresnelDielectric(clamp(dot(-prevDir, curNormal), 0.0, 1.0), 1.0, IOR_WATER);
                radiance += throughput * F * waterReflectionRadiance(curPos, reflect(prevDir, curNormal), seed);
                vec3 T = refract(prevDir, curNormal, 1.0 / IOR_WATER);
                if (dot(T, T) < 0.5) break;
                bounceDir = T;
                throughput *= (1.0 - F);
            } else {
                bounceDir = sampleGlassBsdf(curNormal, prevDir, curEntering, curIsWater ? IOR_WATER : IOR_GLASS, throughput, seed, curIsWater);
            }
            sampledDelta = true;
            if (curIsWater) waterSinceDiffuse = true;
            spriteRay = true;
            // a ray that went through the surface (not reflected) is now in water if it entered, out
            // if it left
            if (curIsWater && dot(bounceDir, curNormal) < 0.0) {
                inWater = curEntering;
                if (inWater) { mediumSigma = waterSigma(curAlbedo, curWaterRefThickness); mediumScatter = waterScatterRadiance(curAlbedo); mediumSurfaceZ = curPos.z; }
            }
        } else {
            if (insideGlass) {
                // same linear "blend toward the tint color, capped" formula as the paired-exit-hit
                // case above
                float dist = length(curPos - glassEntryPos);
                vec3 safeTint = clamp(glassTint, vec3(0.02), vec3(1.0));
                vec3 transmittance = glassMediumIsWater
                    ? mix(vec3(1.0), safeTint, clamp(dist / glassReferenceThickness, 0.0, 1.0))
                    : safeTint;
                throughput *= transmittance;
                insideGlass = false;
            }

            // scales the raw spec-alpha sample by this material's specscale tuning knob before mapping
            // to roughness
            float curRoughness = surfaceRoughness(curSpecIntensity * curSpecScale, curRoughOverride);
            // a metal reads as "metal" almost entirely through glossy/sharp reflections
            curRoughness = mix(curRoughness, min(curRoughness, 0.02), curMetalness);
            // metallic-workflow F0
            vec3 curF0 = mix(DIELECTRIC_F0, curAlbedo, curMetalness);
            // model env-reflect mask (see gHitEnvRefl)
            curF0 = mix(curF0, vec3(1.0), curEnvRefl);
            gSpecWeight = ((curSpecIntensity * curSpecScale > 0.001 || curMetalness > 0.001 || curRoughOverride >= 0.0) ? 1.0 : clamp(p.skyRotationPad.w, 0.0, 1.0)) * curSpecWeight;

            if (dot(throughput, throughput) > 1e-10) {
                gShadeSelfEmitter = curEmissiveModel;
                gShadeGrass = curIsGrass;
                gCausticGatherHere = p.causticParams.x > 0.5 && deltaChain;  // == the gatherCaustics() condition below
                gShadowWaterSigma = inWater ? mediumSigma : vec3(0.0);  // shadow rays from underwater
                gShadowWaterSurfaceZ = mediumSurfaceZ;
                gNoContinuation = bounce >= bounces;  // see gNoContinuation
                PROF_LAP(bounce == 0u ? 9 : 10);
                if (ptCut == 3u) break;  // stop before the camera hit's direct light
                radiance += throughput * directLighting(curPos, curNormal, V, curAlbedo, curF0, curRoughness, curMetalness, seed, curLmIrradiance);
                PROF_LAP(bounce == 0u ? 2 : 3);
                if (ptCut == 2u || ptCut >= 4u) break;  // see ptCut
                gNoContinuation = false;
                gShadowWaterSigma = vec3(0.0);
                gShadeSelfEmitter = false;
                gShadeGrass = false;
                // gathered at the camera's first diffuse vertex, directly seen or through glass
                // (deltaChain), see caustics
                if (p.causticParams.x > 0.5 && deltaChain)
                {
                    PROF_LAP(11);
                    radiance += throughput * curAlbedo * ((1.0 - curMetalness) / PI) * gatherCaustics(curPos, curNormal);
                    gCausticGatherHere = false;
                    PROF_LAP(6);
                }
            }
            if (bounce >= bounces) break;

            bounceDir = sampleBsdfDirection(curNormal, V, curAlbedo, curF0, curRoughness, curMetalness, seed, throughputMul, pdfBsdf);
            waterSinceDiffuse = false;
            if (pdfBsdf <= 1e-8 || dot(throughputMul, throughputMul) <= 0.0) break;
            spriteRay = curRoughness < 0.3 && dot(bounceDir, reflect(prevDir, curNormal)) > 0.97;
            if (!spriteRay) pathSpread = true;
            misPos = curPos;
            misPdfBsdf = pdfBsdf;
        }

        // Russian roulette path termination
        if (bounce == 0u && !curIsGlass) {
            // light blocked by the parallax bumps isn't gone, it bounces off the bump wall
            float v = pomDirVisibility(bounceDir);
            throughputMul *= mix(curAlbedo, vec3(1.0), v);
        }
        {
            const uint ROULETTE_MIN_BOUNCE = 3u;
            if (bounce >= ROULETTE_MIN_BOUNCE) {
                vec3 prospective = curIsGlass ? throughput : (throughput * throughputMul);
                float survivalProb = clamp(max(prospective.r, max(prospective.g, prospective.b)), 0.05, 1.0);
                if (randFloat(seed) > survivalProb) break;
                if (curIsGlass) throughput /= survivalProb;
                else throughputMul /= survivalProb;
            }
        }

        // offset along bounceDir itself, not curNormal
        const float waterSelfSkip = (curIsGlass && curIsWater) ? 0.25 : 0.0;
        vec3 origin = curPos + bounceDir * 0.02;

        rayQueryEXT rq;
        gRayStat[6]++;
        PROF_LAP(11);
        const bool spritesOn = spriteRay && p.particleParams.x > 0.0 && p.particleParams.y > 0.5;
        rayQueryInitializeEXT(rq, uTlas, 0u, RAYMASK_WORLD, origin, 0.0015, bounceDir, 4096.0);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue; if (waterPatchHides(rq)) continue;  // displaced water patch
            bool alphaTestPassed;
            MaterialEntry unusedCandidateEntry;
            if (resolveAlphaTestCandidate(rq, alphaTestPassed, unusedCandidateEntry)) {
                if (alphaTestPassed) rayQueryConfirmIntersectionEXT(rq);
                continue;
            }
            if (rayQueryGetIntersectionTEXT(rq, false) < waterSelfSkip) continue;
            rayQueryConfirmIntersectionEXT(rq);
        }

        // sprites passed in front of whatever this ray hit
        if (spritesOn) {
            const bool missed = rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT;
            radiance += throughput * (sampledDelta ? vec3(1.0) : throughputMul) * spritesAlong(origin, bounceDir, 0.0015, missed ? 4096.0 : rayQueryGetIntersectionTEXT(rq, true));
        }
#ifdef PT_SER
        const uint serMaterial = rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT
            ? 0u : uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
#endif
        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            PROF_LAP(4);
            if (inWater) {
                // an underwater ray that never reaches a surface quad
                float tOut = waterPlaneT(curPos, bounceDir, mediumSurfaceZ);
                if (waterDebug.x < 0.0) waterDebug = tOut > 1e29 ? vec3(1.0, 0.0, 1.0) : vec3(1.0, 1.0, 0.0);  // missed
                vec3 w = throughput * (sampledDelta ? vec3(1.0) : throughputMul);
                if (bounce <= 1u) radiance += w * waterVolumeInscatter(curPos, bounceDir, tOut, mediumSigma, mediumSurfaceZ, seed);  // underwater volumetrics
                if (tOut > 1e29) { radiance += w * mediumScatter; break; }
                vec3 T = exp(-mediumSigma * tOut);
                radiance += w * (vec3(1.0) - T) * mediumScatter;
                throughput *= T;
                inWater = false;
            }
            if (bounce == 0u) primaryEscapedToSky = true;
            // an escaping ray sees the sky
            bool viewThroughGlass = deltaChain && sampledDelta;
            // the BSDF-sampling half of the sky's MIS pair (a delta/glass pick has no NEE partner and
            // takes full weight)
            bool skyboxLight = !viewThroughGlass && skyLightActive();
            vec3 skyL = viewThroughGlass ? sampleRealSky(bounceDir) : (skyboxLight ? skyLightRadianceSkybox(bounceDir) : skyLightRadiance(bounceDir));
            if (skyboxLight && !sampledDelta) {
                float pdfSky = skyPdf(bounceDir);
                skyL *= pdfBsdf / max(pdfBsdf + pdfSky, 1e-10);
            }
            if (viewThroughGlass && !glassFogDone) { glassFogDist = 1e6; glassFogDone = true; }  // escaped
            if (!skyboxLight && !sampledDelta && p.skyRotationPad.z > 0.5 && dot(p.skyAmbientPad.xyz, p.skyAmbientPad.xyz) > 0.0) {
                vec3 skyLevel = max(p.skyAmbientPad.xyz, vec3(1e-4));
                skyL *= clamp(vec3(1.0) - curLmIrradiance / skyLevel, 0.0, 1.0);
            }
            radiance += throughput * (sampledDelta ? vec3(1.0) : throughputMul) * skyL;
            // BSDF-sampling side of the sun's MIS pair
            if (dot(p.sunColorPad.xyz, p.sunColorPad.xyz) > 0.0) {
                vec3 sunDirBase = normalize(-p.sunDirectionRadius.xyz);
                float sunAngularRadius = max(p.sunDirectionRadius.w, 1e-4);
                float cosHalf = cos(sunAngularRadius);
                if (dot(bounceDir, sunDirBase) >= cosHalf) {
                    float solidAngle = max(PI * sunAngularRadius * sunAngularRadius, 1e-8);
                    vec3 sunRadiance = p.sunColorPad.xyz / solidAngle;
                    if (sampledDelta) {
                        if (!(p.causticParams.x > 0.5 && !deltaChain && waterSinceDiffuse))
                            radiance += throughput * sunRadiance * SAUER_LIGHTMAP_OVERBRIGHT * SAUER_BRDF_PI_COMPENSATION;
                    } else {
                        float pdfLight = 1.0 / solidAngle;
                        float misWeight = pdfBsdf / max(pdfLight + pdfBsdf, 1e-10);
                        radiance += throughput * throughputMul * sunRadiance * SAUER_LIGHTMAP_OVERBRIGHT * SAUER_BRDF_PI_COMPENSATION * misWeight;
                    }
                }
            }
            break;
        }

        vec3 hitPos, hitNormal, hitAlbedo, hitEmission;
        float hitSpecIntensity, hitSpecScale, hitTriArea, hitMetalness;
        bool hitIsGlass, hitIsWater, hitEntering;
        // animated water
        float hitWaterRefThickness;
        float hitConeWidth;
        PROF_LAP(4);
        bool bounceFetched = fetchHitAttributes(rq, hitPos, hitNormal, hitAlbedo, hitSpecIntensity, hitSpecScale, hitEmission, hitTriArea, hitMetalness, hitIsGlass, hitIsWater, hitWaterRefThickness, hitEntering,
                                 coneWidth, coneSpreadAngle, hitConeWidth);
        PROF_LAP(5);
        if (!bounceFetched) break;
#if defined(PT_SER) && !defined(PT_SER_TOP)
        // the bounce hit is fetched and its ray query is finished (misses already left the loop above)
#ifdef PT_SER_ONCE
        if (bounce == 0u) {  // one cheap reorder, first bounce hit only
            SER_REORDER((rcUpdatePath ? 2u : 0u) | ((hitIsGlass || hitIsWater) ? 1u : 0u), 2u);
        }
#else
        {
            uint serHint = hitIsGlass ? 1u : (hitIsWater ? 2u : 3u + (serMaterial & 3u));
            if (rcUpdatePath) serHint |= 8u;
            SER_REORDER(serHint, 4u);
        }
#endif
#endif
        float hitEnvRefl = gHitEnvRefl;
        float hitRoughOverride = gHitRoughOverride;
        float hitSpecWeight = gHitSpecWeight;
        bool hitEmissiveModel = gHitModelEmission;
        bool hitIsGrass = gHitIsGrass;
        bool hitIsDynamicInst = gHitIsDynamic;
        float hitLavaGlow = gHitLavaGlow;  // path-traced lava
        if (!hitIsGlass) { gRayStat[11] += uint(clamp(luminance(hitAlbedo), 0.0, 4.0) * 256.0); gRayStat[12]++; }

        if (!sampledDelta) throughput *= throughputMul;
        if (inWater) {
            float segLen = length(hitPos - curPos);
            float tOut = waterPlaneT(curPos, bounceDir, mediumSurfaceZ);
            if (waterDebug.x < 0.0) waterDebug = vec3(clamp(segLen / 32.0, 0.0, 1.0), clamp(hitNormal.z, 0.0, 1.0), tOut < segLen ? 1.0 : 0.0);
            vec3 T = exp(-mediumSigma * min(segLen, tOut));
            radiance += throughput * (vec3(1.0) - T) * mediumScatter;
            if (bounce <= 1u) radiance += throughput * waterVolumeInscatter(curPos, bounceDir, min(segLen, tOut), mediumSigma, mediumSurfaceZ, seed);  // underwater volumetrics
            throughput *= T;
            if (tOut < segLen && !hitIsWater) inWater = false;
        }

        // BSDF-sampling side of the emissive-triangle MIS pair
        if (hitTriArea > 1e-8 && dot(hitEmission, hitEmission) > 0.0) {
            uint emissiveCountHere = uint(p.skyAmbientPad.w);
            if (sampledDelta && !gHitModelEmission && misPdfBsdf > 0.0 && emissiveCountHere > 0u && p.emissiveImportancePad.x > 1e-8) {
                vec3 d = hitPos - misPos;
                float dist2 = max(dot(d, d), 1e-8);
                float cosThetaLight = max(abs(dot(hitNormal, d * inversesqrt(dist2))), 1e-5);
                float lumUnscaled = luminance(hitEmission) / max(p.ambientFloorPad.w, 1e-6);
                if (hitLavaGlow > 0.0) lumUnscaled = hitLavaGlow * luminance(LAVA_NOMINAL);
                float pdfLight = lumUnscaled * dist2 / max(p.emissiveImportancePad.x * cosThetaLight, 1e-8);
                radiance += throughput * hitEmission * (misPdfBsdf / max(pdfLight + misPdfBsdf, 1e-10));
            } else if (sampledDelta || gHitModelEmission) {  // model emission has no NEE partner, see gHitModelEmission
                radiance += throughput * hitEmission;
            } else {
                uint emissiveCount = uint(p.skyAmbientPad.w);
                if (emissiveCount > 0u && p.emissiveImportancePad.x > 1e-8) {
                    float dist = length(hitPos - curPos);
                    float cosThetaLight = max(abs(dot(hitNormal, bounceDir)), 1e-5);
                    float glowScaleSafe = max(p.ambientFloorPad.w, 1e-6);
                    float lumUnscaled = luminance(hitEmission) / glowScaleSafe;
                    if (hitLavaGlow > 0.0) lumUnscaled = hitLavaGlow * luminance(LAVA_NOMINAL);  // NEE's selection weight
                    float pdfLight = lumUnscaled * dist * dist / max(p.emissiveImportancePad.x * cosThetaLight, 1e-8);
                    float misWeight = pdfBsdf / max(pdfLight + pdfBsdf, 1e-10);
                    radiance += throughput * hitEmission * misWeight;
                } else {
                    // defensive
                    radiance += throughput * hitEmission;
                }
            }
        }

        if (deltaChain && sampledDelta && !glassFogDone) {
            glassFogDist += length(hitPos - curPos);
            if (!hitIsGlass) { glassFogDone = true; floorAlbedo = throughput * hitAlbedo; }
        }
        // the primary is a model mirror and this bounce is its mirror reflection
        if (bounce == 0u && primaryEnvRefl > 0.0 && !primaryIsGlass && !hitIsGlass &&
            dot(bounceDir, reflect(prevDir, curNormal)) > 0.98) {
            floorAlbedo += throughput * hitAlbedo;
        }
        if (!sampledDelta) deltaChain = false;
        // the hit is still camera-seen only through delta (glass/water) or mirror-like reflections
        {
            bool mirrorLike = !sampledDelta && !curIsGlass && dot(bounceDir, reflect(prevDir, curNormal)) > 0.995 &&
                (curEnvRefl > 0.0 || curMetalness > 0.5 || surfaceRoughness(curSpecIntensity * curSpecScale, curRoughOverride) < 0.3);
            viewChain = viewChain && (sampledDelta || mirrorLike);
            vec3 ratio = vec3(1.0);
            if (!hitIsGlass) {
                vec3 tA = transportAlbedo(hitAlbedo);
                if (viewChain) ratio = displayToTransportRatio(hitAlbedo);
                else hitAlbedo = tA;
            }
            curDisplayToTransport = ratio;
        }
        curPos = hitPos;
        curNormal = hitNormal;
        curAlbedo = hitAlbedo;
        curSpecIntensity = hitSpecIntensity;
        curSpecScale = hitSpecScale;
        curMetalness = hitMetalness;
        curEnvRefl = hitEnvRefl;
        curRoughOverride = hitRoughOverride;
        curSpecWeight = hitSpecWeight;
        curEmissiveModel = hitEmissiveModel;
        curIsGrass = hitIsGrass;
        curIsDynamic = hitIsDynamicInst;
        curIsGlass = hitIsGlass;
        // animated water
        curIsWater = hitIsWater;
        curWaterRefThickness = hitWaterRefThickness;
        curEntering = hitEntering;
        prevDir = bounceDir;
        coneWidth = hitConeWidth;  // carried forward as next bounce's own starting width
    }

    PROF_LAP(13);
    gRayStat[13] += uint(clamp(luminance(radiance), 0.0, 64.0) * 256.0);
    if (diagRadAtDeep.x >= 0.0) gRayStat[14] += uint(clamp(luminance(radiance - diagRadAtDeep), 0.0, 64.0) * 256.0);
    // write back each recorded vertex's outgoing light
    for (uint k = 0u; k < rcCount; ++k) {
        if (any(lessThan(rcT[k], vec3(1e-3)))) continue;
        vec3 Lk = (radiance - rcBefore[k]) / rcT[k];
        if (!finite3(Lk)) continue;  // never let a bad sample into a cell
        Lk = clamp(Lk, vec3(0.0), vec3(32.0));
        int sl = rcInsert(rcSlot[k], rcCheck[k]);
        if (sl < 0) continue;
        atomicAdd(rcAccum[sl].x, uint(Lk.r * RC_SCALE));
        atomicAdd(rcAccum[sl].y, uint(Lk.g * RC_SCALE));
        atomicAdd(rcAccum[sl].z, uint(Lk.b * RC_SCALE));
        atomicAdd(rcAccum[sl].w, 1u);
    }
    PROF_LAP(15);  // radiance-cache write-back
    // the cache's bounced light replaces most of Sauerbraten's flat floor
    vec3 floorValue = p.ambientFloorPad.xyz * (rcOn ? p.cacheParams2.x : 1.0);
    radiance = max(radiance, floorAlbedo * floorValue * SAUER_LIGHTMAP_OVERBRIGHT);
    radianceAccum += radiance;
    if (sampleIdx == 0u && primaryIsGlass) fogLinearDist = glassFogDist;
    PROF_LAP(16);  // floor / per-sample end
    }  // samples-per-pixel loop
    vec3 radiance = radianceAccum / float(sppCount);

#if PATH_TRACE_DEBUG_METALNESS
    radiance = vec3(metalness);
#endif

    float encodedDepth = primaryIsDynamic ? -rawDepth : rawDepth;
    if (!finite3(radiance)) radiance = vec3(0.0);
    if (p.waterParams2.w > 0.5) radiance = waterDebug.x >= 0.0 ? waterDebug : radiance * 0.15;  // ptwaterdebug
    imageStore(uRawRadiance, pixel, vec4(radiance, encodedDepth));
    imageStore(uLinearDepthOut, pixel, vec4(fogLinearDist, specVirtualDist, 0.0, 0.0));
    gRayStat[0]++;
    PROF_LAP(14);
    PROF_FINISH();
    flushRayStats();
}
#else  // CAUSTIC_PHOTON_PASS, water caustic photons, see caustics
// photons per batch (y = batch), placed by camera-importance (see causticAreaPdf)
void main() {
    uint N = causticPerBatch();
    uint pid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    uint batch = gl_WorkGroupID.y;
    if (N == 0u || pid >= N || batch >= CAUSTIC_BATCHES) return;
    gPixel = ivec2(0); gBounce = 0u; gSample = 0u;

    vec3 cam = (p.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    uint frameSeed = pcgHash(p.frameData.x * 0x9E3779B9u ^ pcgHash(batch * 0x85EBCA6Bu + 0x2545F491u));
    uint rotU = frameSeed, rotV = pcgHash(frameSeed);
    vec2 u = vec2(float(pid * 0xC13FA9A9u + rotU), float(pid * 0x91E10DA5u + rotV)) * (1.0 / 4294967296.0);
    float rr = CAUSTIC_NEAR * sqrt(max(exp(u.x * causticLnK()) - 1.0, 0.0));  // inverse CDF of the radial density
    float th = 6.28318530718 * u.y;
    vec2 xy = cam.xy + rr * vec2(cos(th), sin(th));
    float photonArea = 1.0 / (float(N) * causticAreaPdf(rr));
    uint seed = pcgHash(pid * 9781u ^ frameSeed);

    rayQueryEXT wq;
    rayQueryInitializeEXT(wq, uTlas, gl_RayFlagsCullOpaqueEXT, RAYMASK_WORLD, vec3(xy, cam.z + 2048.0), 0.0, vec3(0.0, 0.0, -1.0), 8192.0);
    while (rayQueryProceedEXT(wq)) {
        if (rayQueryGetIntersectionTypeEXT(wq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue; if (waterPatchHides(wq)) continue;  // displaced water patch
        if (causticWaterCandidate(wq)) rayQueryConfirmIntersectionEXT(wq);
    }
    if (rayQueryGetIntersectionTypeEXT(wq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return;
    vec3 g, gN, gAlbedo, gEm;
    float gs, gss, gta, gm, gwt, gcw;
    bool gg, gw, ge;
    if (!fetchHitAttributes(wq, g, gN, gAlbedo, gs, gss, gEm, gta, gm, gg, gw, gwt, ge, 0.0, 0.0, gcw)) return;
    if (!gw || !ge) return;  // a top surface, met from above

    vec3 sunL = vec3(0.0);
    float wSun = 0.0;
    if (dot(p.sunColorPad.xyz, p.sunColorPad.xyz) > 0.0) {
        vec3 sb = normalize(-p.sunDirectionRadius.xyz);
        vec3 t, bt; buildBasis(sb, t, bt);
        float ar = max(p.sunDirectionRadius.w, 0.0);
        float rr = ar * sqrt(randFloat(seed)), th = 6.28318530718 * randFloat(seed);
        sunL = normalize(sb + t * (rr * cos(th)) + bt * (rr * sin(th)));
        wSun = luminance(p.sunColorPad.xyz) * max(sunL.z, 0.0);
    }
    uint lightCount = p.frameData.w;
    LightList photonLights = lightListAt(g, lightCount);
    uint photonLightCount = lightListSize(photonLights);
    float W = wSun;
    for (uint k = 0u; k < photonLightCount; ++k) {
        uint li = lightListGet(photonLights, k);
        if (li < lightCount && lights[li].posRadius.z > g.z) W += causticLightWeight(li, g, vec3(0.0, 0.0, 1.0));
    }
    if (W <= 0.0) return;
    float pick = randFloat(seed) * W;
    int chosen = -1;  // -1 = sun
    vec3 L; float distToLight; vec3 lightColor;
    float attenG = 1.0, lightRadius = 0.0;
    bool noFalloff = true;
    if (pick < wSun) {
        L = sunL; distToLight = 4096.0; lightColor = p.sunColorPad.xyz;
    } else {
        float acc = wSun;
        for (uint k = 0u; k < photonLightCount; ++k) {
            uint li = lightListGet(photonLights, k);
            float w = (li < lightCount && lights[li].posRadius.z > g.z) ? causticLightWeight(li, g, vec3(0.0, 0.0, 1.0)) : 0.0;
            acc += w;
            if (w > 0.0 && pick < acc) { chosen = int(li); break; }
        }
        if (chosen < 0) return;
        vec3 tl = lightNearestPoint(lights[chosen].posRadius.xyz, lightHalfAxis(lights[chosen].colorFlags, lights[chosen].reserved), g) - g;
        distToLight = length(tl); L = tl / distToLight;
        lightColor = lights[chosen].colorFlags.xyz;
        lightRadius = lights[chosen].posRadius.w;
        noFalloff = (int(lights[chosen].colorFlags.w + 0.5) & 2) != 0;
        attenG = noFalloff ? 1.0 : max(1.0 - distToLight / lightRadius, 0.0);
    }
    float lumC = luminance(lightColor);
    if (lumC <= 0.0) return;
    // flux onto the photon's area (horizontal, photonArea), directLighting() units
    vec3 power = lightColor / lumC * (W * photonArea) * SAUER_LIGHTMAP_OVERBRIGHT * SAUER_BRDF_PI_COMPENSATION;

    vec3 vis = traceShadowRayTinted(g + vec3(0.0, 0.0, 0.05), L, distToLight - 0.1);
    if (dot(vis, vis) <= 0.0) return;
    power *= vis;

    vec3 n = waterWaveNormalAt(g.xy, p.waterFft, p.waterMap, waterAmp(), p.causticParams2.x);
    if (p.waterParams.z <= 0.0) n = gN.z > 0.0 ? gN : -gN;
    float F = fresnelDielectric(clamp(dot(L, n), 0.0, 1.0), 1.0, IOR_WATER);
    vec3 T = refract(-L, n, 1.0 / IOR_WATER);
    if (dot(T, T) < 0.5) return;
    T = normalize(T);
    power *= 1.0 - F;
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTlas, 0u, RAYMASK_WORLD, g + T * 0.02, 0.0015, T, 8192.0);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue; if (waterPatchHides(rq)) continue;  // displaced water patch
        bool passed; MaterialEntry unusedEntry;
        if (resolveAlphaTestCandidate(rq, passed, unusedEntry)) { if (passed) rayQueryConfirmIntersectionEXT(rq); continue; }
        rayQueryConfirmIntersectionEXT(rq);  // glass/water
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return;
    vec3 hitPos, hitN, hitAlbedo, hitEmission;
    float hs, hss, hta, hm, hwt, hcw;
    bool hg, hw, he;
    if (!fetchHitAttributes(rq, hitPos, hitN, hitAlbedo, hs, hss, hitEmission, hta, hm, hg, hw, hwt, he, 0.0, 0.0, hcw)) return;
    if (hw || hg) return;  // out through another surface
    float seg = length(hitPos - g);
    power *= exp(-waterSigma(gAlbedo, gwt) * seg);
    if (chosen >= 0 && !noFalloff) power *= max(1.0 - (distToLight + seg) / lightRadius, 0.0) / max(attenG, 1e-4);
    power *= causticWindowWeight(hitPos);  // the window's fade, the shadow rays carry the rest
    if (luminance(power) <= 1e-8) return;
    uint local = atomicAdd(causticHeader[batch].x, 1u);
    if (local >= N) return;
    uint idx = batch * N + local;
    uint level = causticLevelOf(length(hitPos.xy - cam.xy));
    ivec3 hc = ivec3(floor(hitPos / causticCellSizeL(level)));
    uint prev = atomicExchange(causticHeads[batch * causticHashSize() + causticHashL(hc, level)], idx);
    causticPhotons[idx].posNext = vec4(hitPos, uintBitsToFloat(prev));
    causticPhotons[idx].powerKey = vec4(power, uintBitsToFloat(causticKeyL(hc, level)));
    causticPhotons[idx].normal = vec4(hitN, 0.0);
}
#endif
