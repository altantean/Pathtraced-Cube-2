// skybox light builds the sky's sampling distribution (see skybox light)
layout(local_size_x = 256) in;
shared float sSum[256];
shared float sEup[256];
void main() {
    uint t = gl_LocalInvocationID.x;
    const uint PER = SKY_CELLS / 256u;
    float lum[PER];
    float sum = 0.0, eup = 0.0;
    for (uint i = 0u; i < PER; ++i) {
        uint cell = t * PER + i;
        vec2 base = vec2(float(cell % SKY_W), float(cell / SKY_W));
        float l = 0.0;
        for (uint k = 0u; k < 4u; ++k) {
            vec2 uv = (base + vec2(0.25 + 0.5 * float(k & 1u), 0.25 + 0.5 * float(k >> 1))) / vec2(float(SKY_W), float(SKY_H));
            vec3 dl = skyUvToDir(uv);
            float sl = luminance(sampleRealSky(skyLocalToWorld(dl)));
            l += sl;
            eup += sl * max(dl.z, 0.0);
        }
        lum[i] = l * 0.25;
        sum += lum[i];
    }
    sSum[t] = sum; sEup[t] = eup;
    barrier();
    for (uint off = 128u; off > 0u; off >>= 1) {
        if (t < off) { sSum[t] += sSum[t + off]; sEup[t] += sEup[t + off]; }
        barrier();
    }
    float total = sSum[0];
    float eUp = sEup[0] * (4.0 * PI / float(SKY_CELLS * 4u));  // each sample covers 4pi / (cells * 4) sr
    barrier();
    // A small floor keeps every cell sampleable (pdf > 0 wherever the sky has light)
    float floorW = 0.02 * total / float(SKY_CELLS);
    float local = 0.0;
    for (uint i = 0u; i < PER; ++i) { lum[i] += floorW; local += lum[i]; }
    // inclusive scan of the per-thread sums (Hillis-Steele)
    sSum[t] = local;
    barrier();
    for (uint off = 1u; off < 256u; off <<= 1) {
        float v = t >= off ? sSum[t - off] : 0.0;
        barrier();
        sSum[t] += v;
        barrier();
    }
    float grand = sSum[255];
    float acc = sSum[t] - local;
    float inv = grand > 0.0 ? 1.0 / grand : 0.0;
    for (uint i = 0u; i < PER; ++i) { acc += lum[i]; skyCdf[t * PER + i] = (t == 255u && i == PER - 1u) ? 1.0 : acc * inv; }
    if (t == 0u) {
        // calibration
        float target = PI * luminance(p.skyAmbientPad.xyz * SAUER_LIGHTMAP_OVERBRIGHT);
        float calib = target > 0.0 ? target / max(eUp, 1e-6) : 1.0;
        skyHeader = vec4(calib * p.skyRotationPad.y, float(SKY_CELLS) / (4.0 * PI), 0.0, (total > 0.0 && p.skyRotationPad.y > 0.0) ? 1.0 : 0.0);
    }
}
