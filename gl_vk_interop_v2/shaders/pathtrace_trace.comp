vec3 glassVolumeTint(vec3 glassColor) {
    float m = max(glassColor.r, max(glassColor.g, glassColor.b));
    vec3 hue = m > 1e-3 ? glassColor / m : vec3(1.0);
    return mix(vec3(1.0), hue, clamp(p.glassParams.x, 0.0, 1.0));
}
