const float PI = 3.14159265358979323846;

uint pcgHash(uint x) {
    x = x * 747796405u + 2891336453u;
    uint w = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
    return (w >> 22u) ^ w;
}

float randFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) * (1.0 / 4294967296.0);
}

ivec2 gPixel;
uint gBounce;
// TLAS instance masks
const uint RAYMASK_WORLD = 0x7Du;
const uint RAYMASK_PARTICLE = 0x80u;
const uint PARTICLE_MATERIAL = 0xFFFFFFFEu;
// sample index within this pixel's samples-per-pixel loop (pathtracespp)
uint gSample = 0u;
// specular weight of the current shading vertex
float gSpecWeight = 1.0;

vec2 blueNoise2D(uint dimensionTag) {
    uint dim = dimensionTag * 16u + gBounce + gSample * 4099u;
    uint bnIdx = p.skyFaceIndexHi.w;
    if (bnIdx != 0xFFFFFFFFu) {
        // temporal
        uint h = pcgHash(dim * 0x9E3779B9u + 0x68E31DA4u ^ pcgHash(p.frameData.x * 0x85EBCA6Bu + 0x27D4EB2Fu));
        ivec2 shift = ivec2(int(h & 63u), int((h >> 6u) & 63u));
        vec2 bn = texelFetch(uMapTextures[nonuniformEXT(bnIdx)], (gPixel + shift) & ivec2(63), 0).rg;
        bn += (0.5 / 256.0);  // centre of each 8-bit bucket
        uint hv = pcgHash(h ^ 0xB5297A4Du);
        vec2 rot = vec2(float(hv & 0xFFFFu), float(hv >> 16u)) * (1.0 / 65536.0);
        return fract(bn + rot);
    }
    uint baseSeed = uint(gPixel.x) * 1973u ^ uint(gPixel.y) * 9277u ^ dim * 26699u ^ p.frameData.x * 83492791u;
    uint h1 = pcgHash(baseSeed);
    uint h2 = pcgHash(baseSeed ^ 0x9E3779B9u);
    return vec2(float(h1) * (1.0 / 4294967296.0), float(h2) * (1.0 / 4294967296.0));
}

void buildBasis(vec3 n, out vec3 tangent, out vec3 bitangent) {
    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(up, n));
    bitangent = cross(n, tangent);
}

// cosine-weighted hemisphere sample around n
vec3 cosineSampleHemisphere(vec3 n, inout uint seed) {
    vec2 u = blueNoise2D(0u);
    randFloat(seed); randFloat(seed);
    float u1 = u.x, u2 = u.y;
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    vec3 tangent, bitangent;
    buildBasis(n, tangent, bitangent);
    vec3 dir = tangent * (r * cos(theta)) + bitangent * (r * sin(theta)) + n * sqrt(max(0.0, 1.0 - u1));
    return normalize(dir);
}

vec3 jitterSunDirection(vec3 sunDir, float angularRadius, inout uint seed) {
    if (angularRadius <= 0.0) return sunDir;
    vec2 u = blueNoise2D(1u);
    randFloat(seed); randFloat(seed);
    float u1 = u.x, u2 = u.y;
    float r = angularRadius * sqrt(u1);
    float theta = 6.28318530718 * u2;
    vec3 tangent, bitangent;
    buildBasis(sunDir, tangent, bitangent);
    return normalize(sunDir + tangent * (r * cos(theta)) + bitangent * (r * sin(theta)));
}

vec3 traceShadowRayTinted(vec3 origin, vec3 dir, float maxDist);
// set by directLighting() around its sun shadow ray
float gShadowWaterCaustic = 0.0;
bool gCausticGatherHere = false;

bool gPrimaryGradRequest = false;  // set only around the primary hit's fetch
vec3 gPrimRayOrigin, gPrimDirDx, gPrimDirDy;
bool gUseGrad = false;  // this fetch has valid derivatives
vec2 gUvDx, gUvDy;  // d(uv)/dx, d(uv)/dy of the hit's main UV
vec3 gDBaryDx, gDBaryDy;  // barycentric derivatives (for other UV sets)

vec3 rtBarycentric(vec3 pt, vec3 a, vec3 b, vec3 c) {
    vec3 e0 = b - a, e1 = c - a, e2 = pt - a;
    float d00 = dot(e0, e0), d01 = dot(e0, e1), d11 = dot(e1, e1), d20 = dot(e2, e0), d21 = dot(e2, e1);
    float den = d00 * d11 - d01 * d01;
    if (abs(den) < 1e-20) return vec3(1.0, 0.0, 0.0);
    float bv = (d11 * d20 - d01 * d21) / den, bw = (d00 * d21 - d01 * d20) / den;
    return vec3(1.0 - bv - bw, bv, bw);
}

const float SAUER_LIGHTMAP_OVERBRIGHT = 2.0;

const float SAUER_BRDF_PI_COMPENSATION = PI;

// ============================================================ pbr materials

const float ROUGHNESS_MIN = 0.05;
const float ROUGHNESS_MAX = 0.9;
const vec3 DIELECTRIC_F0 = vec3(0.04);

float specIntensityToRoughness(float specIntensity) {
    return clamp(mix(ROUGHNESS_MAX, ROUGHNESS_MIN, clamp(specIntensity, 0.0, 1.0)), ROUGHNESS_MIN, ROUGHNESS_MAX);
}

// material model (ptmat 1) Sauerbraten's authored specular, translated physically
const float MAT_MIRROR_KS = 1600.0;
vec3 transportAlbedo(vec3 a) {
    if (p.matParams.y < 0.5) return a;
    float lum = dot(a, vec3(0.2126, 0.7152, 0.0722));  // luminance(), defined further down
    if (lum <= 1e-5) return a;
    float e = clamp(p.matParams.z, 1.0, 2.2) / 2.2;
    return min(a * (pow(lum, e) / lum), vec3(0.9));
}

vec3 displayToTransportRatio(vec3 a) {
    if (p.matParams.y < 0.5) return vec3(1.0);
    vec3 r = transportAlbedo(a) / max(a, vec3(1e-4));
    return mix(vec3(1.0), clamp(r, vec3(0.05), vec3(100.0)), greaterThan(a, vec3(1e-4)));
}
bool finite3(vec3 v) { return !any(isnan(v)) && !any(isinf(v)); }
float materialRoughness(float ks);
// A vertex's roughness
float surfaceRoughness(float ks, float roughOverride) {
    return roughOverride >= 0.0 ? max(roughOverride, ROUGHNESS_MIN) : materialRoughness(ks);
}
float materialRoughness(float ks) {
    if (p.matParams.x < 0.5) return specIntensityToRoughness(clamp(ks, 0.0, 1.0));
    float a = clamp(0.1 / sqrt(max(ks, 1e-6)), ROUGHNESS_MIN * ROUGHNESS_MIN, ROUGHNESS_MAX * ROUGHNESS_MAX);
    return sqrt(a);
}

float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

float ggxD(float NdotH, float alpha) {
    float a2 = alpha * alpha;
    float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / max(PI * d * d, 1e-8);
}

float smithG1(float NdotX, float alpha) {
    float a2 = alpha * alpha;
    return 2.0 * NdotX / max(NdotX + sqrt(a2 + (1.0 - a2) * NdotX * NdotX), 1e-6);
}

float smithG(float NdotV, float NdotL, float alpha) {
    return smithG1(NdotV, alpha) * smithG1(NdotL, alpha);
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    float m = clamp(1.0 - cosTheta, 0.0, 1.0);
    return F0 + (vec3(1.0) - F0) * (m * m * m * m * m);
}

// probability of choosing the specular lobe when sampling a bounce direction
float specularLobeProbability(float roughness, float metalness) {
    float t = clamp((roughness - ROUGHNESS_MIN) / max(ROUGHNESS_MAX - ROUGHNESS_MIN, 1e-4), 0.0, 1.0);
    float dielectricProb = mix(0.85, 0.05, t) * gSpecWeight;
    return mix(dielectricProb, 1.0, metalness);
}

vec3 evalBsdf(vec3 N, vec3 V, vec3 L, vec3 albedo, vec3 F0, float roughness, float metalness, out float pdf) {
    float NdotL = dot(N, L);
    float NdotV = max(dot(N, V), 1e-4);
    if (NdotL <= 0.0) { pdf = 0.0; return vec3(0.0); }
    vec3 H = normalize(V + L);
    float NdotH = max(dot(N, H), 0.0);
    float VdotH = max(dot(V, H), 0.0);
    float alpha = max(roughness * roughness, 0.0016);
    vec3 F = fresnelSchlick(VdotH, F0);
    float D = ggxD(NdotH, alpha);
    float G = smithG(NdotV, NdotL, alpha);
    F *= gSpecWeight;
    vec3 specular = (D * G) * F / max(4.0 * NdotV * NdotL, 1e-6);
    // energy conservation
    vec3 diffuse = (vec3(1.0) - F) * albedo * (1.0 - metalness) / PI;
    float pdfDiffuse = NdotL / PI;
    float pdfSpecular = D * NdotH / max(4.0 * VdotH, 1e-6);
    float specProb = specularLobeProbability(roughness, metalness);
    pdf = mix(pdfDiffuse, pdfSpecular, specProb);
    return diffuse + specular;
}

vec3 sampleBsdfDirection(vec3 N, vec3 V, vec3 albedo, vec3 F0, float roughness, float metalness, inout uint seed,
                          out vec3 throughputMul, out float pdfOut) {
    float specProb = specularLobeProbability(roughness, metalness);
    vec3 L;
    if (blueNoise2D(3u).x < specProb) {
        vec3 tangent, bitangent;
        buildBasis(N, tangent, bitangent);
        vec2 ggxU = blueNoise2D(4u);
        float u1 = ggxU.x;
        float u2 = ggxU.y;
        float alpha = max(roughness * roughness, 0.0016);
        float phi = 6.28318530718 * u1;
        float cosTheta = sqrt(max(0.0, (1.0 - u2) / (1.0 + (alpha * alpha - 1.0) * u2)));
        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
        vec3 Hlocal = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
        vec3 H = normalize(tangent * Hlocal.x + bitangent * Hlocal.y + N * Hlocal.z);
        L = reflect(-V, H);
    } else {
        L = cosineSampleHemisphere(N, seed);
    }
    if (dot(N, L) <= 0.0) { throughputMul = vec3(0.0); pdfOut = 0.0; return L; }
    float pdf;
    vec3 f = evalBsdf(N, V, L, albedo, F0, roughness, metalness, pdf);
    if (pdf > 1e-8) {
        throughputMul = f * dot(N, L) / pdf;
        pdfOut = pdf;
    } else {
        throughputMul = vec3(0.0);
        pdfOut = 0.0;
    }
    return L;
}

const float IOR_GLASS = 1.5;
const float IOR_WATER = 1.33;

// dielectric (glass) BSDF
vec3 waterSigma(vec3 color, float fogDepth) {
    float d = max(fogDepth, 1.0) * max(p.waterParams.y, 0.01);
    return -log(clamp(color, vec3(0.02), vec3(0.98))) / d;
}
vec3 waterScatterRadiance(vec3 color) {
    return color * (p.skyAmbientPad.xyz + p.sunColorPad.xyz * (p.waterVolume.x > 0.0 ? 0.0 : 0.25)) * p.waterParams2.x;
}
// rt_water.glsl's amp
vec4 waterAmp() { return vec4(p.waterParams.z, p.waterWave.y, 0.0, p.waterWave.w); }
// the FFT sea's normal (rt_water.glsl) on a top / bottom face
vec3 waterWaveNormal(vec3 pos, vec3 n) {
    if (p.waterParams.z <= 0.0 || abs(n.z) < 0.5) return n;
    vec3 wn = waterWaveNormalAt(pos.xy, p.waterFft, p.waterMap, waterAmp(), 1.0);
    return n.z > 0.0 ? wn : vec3(wn.xy, -wn.z);
}
// inside the patch the displaced surface (water_patch.comp) replaces the flat water chunk
bool waterPatchHides(rayQueryEXT rq) {
    if (p.waterPatch.z <= 0.0) return false;
    int inst = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false);
    float prim = float(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
    bool flatWater = inst == int(p.waterPatch.w) && prim < p.waterWave.z;
    bool flatLava = inst == int(p.lavaPatch.x) && prim < p.lavaPatch.y;
    if (!flatWater && !flatLava) return false;
    vec3 hp = rayQueryGetWorldRayOriginEXT(rq) + rayQueryGetWorldRayDirectionEXT(rq) * rayQueryGetIntersectionTEXT(rq, false);
    vec2 d = hp.xy - p.waterPatch.xy;
    return d.x >= 0.0 && d.y >= 0.0 && d.x < p.waterPatch.z && d.y < p.waterPatch.z;
}
// underwater shadow rays
bool gHitIsGrass = false;
bool gShadeGrass = false;
vec3 gShadowWaterSigma = vec3(0.0);
float gShadowWaterSurfaceZ = 0.0;
// distance along dir from o to the water plane at surfaceZ (1e30 if the ray never rises through it)
float waterPlaneT(vec3 o, vec3 dir, float surfaceZ) {
    return dir.z > 1e-5 ? max((surfaceZ - o.z) / dir.z, 0.0) : 1e30;
}

vec3 sampleGlassBsdf(vec3 N, vec3 rayDir, bool entering, float iorInside, inout vec3 throughput, inout uint seed, bool water) {
    float iorFrom = entering ? 1.0 : iorInside;
    float iorTo = entering ? iorInside : 1.0;
    float eta = iorFrom / iorTo;

    float cosI = clamp(dot(-rayDir, N), 0.0, 1.0);
    float thinness = water ? 0.0 : clamp(p.emissiveImportancePad.w, 0.0, 1.0);
    if (!entering && thinness > 0.0) {
        float sinI = sqrt(max(0.0, 1.0 - cosI * cosI)) * mix(1.0, 1.0 / iorInside, thinness);
        cosI = sqrt(max(0.0, 1.0 - sinI * sinI));
    }
    float sin2T = eta * eta * max(0.0, 1.0 - cosI * cosI);

    float fresnel;
    if (sin2T >= 1.0) {
        fresnel = 1.0;
    } else {
        float cosT = sqrt(max(0.0, 1.0 - sin2T));
        float rs = (iorFrom * cosI - iorTo * cosT) / max(iorFrom * cosI + iorTo * cosT, 1e-6);
        float rp = (iorTo * cosI - iorFrom * cosT) / max(iorTo * cosI + iorFrom * cosT, 1e-6);
        fresnel = clamp(0.5 * (rs * rs + rp * rp), 0.0, 1.0);
    }
    if (!water) fresnel = entering ? mix(fresnel, 2.0 * fresnel / (1.0 + fresnel), thinness) : fresnel * (1.0 - thinness);

    if (randFloat(seed) < fresnel) {
        return reflect(rayDir, N);
    }
    vec3 refracted = refract(rayDir, N, eta);
    // exit face of a thin pane
    if (dot(refracted, refracted) < 0.5) refracted = rayDir;
    // blend the Snell's-law-refracted direction toward the original unbent incident direction
    vec3 thinDir = normalize(mix(refracted, rayDir, thinness));
    if (!water) throughput *= mix(eta * eta, 1.0, thinness);
    return thinDir;
}

// fetches the Sauerbraten material description for a vertex's materialIndex (its VSlot index)
MaterialInfo fetchMaterialInfo(uint materialIndex) {
    if (materialIndex < materialInfos.length()) return materialInfos[materialIndex];
    MaterialInfo fallback;
    fallback.diffuseTexIndex = 0u;
    fallback.normalTexIndex = 0u;
    fallback.glowTexIndex = 0u;
    fallback.flags = 0u;
    // colorscale.w is repurposed to carry metalness
    fallback.colorscale = vec4(1.0, 1.0, 1.0, 0.0);
    fallback.glowcolor = vec4(1.0);
    fallback.scroll = vec4(0.0);
    fallback.parallax = vec4(0.0);
    return fallback;
}

// glass-aware shadow/visibility ray
const uint MAX_GLASS_SHADOW_HITS = 4u;

layout(std430, set = 0, binding = 25) buffer RayStatsBuf { uint rayStats[64]; };
// radiance cache world-space multi-bounce GI (no ReSTIR, no RIS)
layout(std430, set = 0, binding = 27) buffer RcKeyBuf { uvec2 rcKeys[]; };  // x = checksum (0 = empty), y = frame last written
layout(std430, set = 0, binding = 28) buffer RcAccumBuf { uvec4 rcAccum[]; };  // rgb * RC_SCALE, sample count, this frame
layout(std430, set = 0, binding = 29) buffer RcRadianceBuf { vec4 rcRadiance[]; };  // rgb, frames of data (capped)
const uint RC_SIZE = 1u << 20;  // keep in sync with RayTracingScene::kRadianceCacheSize
const uint RC_MASK = RC_SIZE - 1u;
const float RC_SCALE = 256.0;
const uint RC_PROBES = 8u;

// cell of a surface point
void rcCell(vec3 pos, vec3 n, vec3 camPos, out uint slot0, out uint check) {
    float dist = length(pos - camPos);
    int level = clamp(int(floor(log2(max(dist, 1.0) / 32.0))), 0, 10);
    float cell = max(p.cacheParams.y, 0.25) * float(1 << level);
    ivec3 q = ivec3(floor(pos / cell));
    vec3 an = abs(n);
    uint nd = (an.x >= an.y && an.x >= an.z) ? (n.x > 0.0 ? 0u : 1u) : ((an.y >= an.z) ? (n.y > 0.0 ? 2u : 3u) : (n.z > 0.0 ? 4u : 5u));
    uint h = pcgHash(uint(q.x) ^ pcgHash(uint(q.y) ^ pcgHash(uint(q.z) ^ pcgHash(uint(level) * 8u + nd))));
    slot0 = h & RC_MASK;
    check = pcgHash(h ^ 0x68E31DA4u ^ (uint(q.x) * 73856093u) ^ (uint(q.z) * 19349663u)) | 1u;
}
int rcFind(uint slot0, uint check) {
    for (uint i = 0u; i < RC_PROBES; ++i) {
        uint sl = (slot0 + i) & RC_MASK;
        uint k = rcKeys[sl].x;
        if (k == check) return int(sl);
        if (k == 0u) return -1;
    }
    return -1;
}
int rcInsert(uint slot0, uint check) {
    for (uint i = 0u; i < RC_PROBES; ++i) {
        uint sl = (slot0 + i) & RC_MASK;
        uint prev = atomicCompSwap(rcKeys[sl].x, 0u, check);
        if (prev == 0u || prev == check) return int(sl);
    }
    return -1;
}

uint gRayStat[20] = uint[20](0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);
#ifdef PT_PROFILE
uint64_t gProf[22] = uint64_t[22](0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul, 0ul);
uint64_t gLap = 0ul;
#define PROF_START() if (p.glassParams.w > 1.5) { gLap = clockARB(); gProf[0] = gLap; }
#define PROF_LAP(i) if (p.glassParams.w > 1.5) { uint64_t tNow = clockARB(); gProf[i] += tNow - gLap; gLap = tNow; }
#define PROF_FINISH() if (p.glassParams.w > 1.5) { gProf[0] = clockARB() - gProf[0]; }
#else
#define PROF_START()
#define PROF_LAP(i)
#define PROF_FINISH()
#endif
void flushRayStats() {
    if (p.glassParams.w < 0.5) return;
    // [[unroll]]
    [[unroll]] for (int i = 0; i < 16; ++i) {
        uint sum = subgroupAdd(i == 10 ? (gRayStat[i] + 4u) >> 3 : gRayStat[i]);
        if (subgroupElect() && sum != 0u) atomicAdd(rayStats[i], sum);
    }
    [[unroll]] for (int i = 16; i < 20; ++i) {
        uint sum = subgroupAdd(gRayStat[i]);
        if (subgroupElect() && sum != 0u) atomicAdd(rayStats[44 + i], sum);
    }
#ifdef PT_PROFILE
    [[unroll]] for (int i = 0; i < 22; ++i) {
        uint lane = uint(min(gProf[i] >> 6ul, uint64_t(0x7FFFFFu)));  // 64-cycle units
        uint warpAvg = subgroupAdd(lane) / gl_SubgroupSize;
        if (subgroupElect() && warpAvg != 0u) {
            uint old = atomicAdd(rayStats[16 + 2 * i], warpAvg);
            if (old + warpAvg < old) atomicAdd(rayStats[17 + 2 * i], 1u);  // carry into the high word
        }
    }
#endif
}

vec3 traceShadowRayTinted(vec3 origin, vec3 dir, float maxDist) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTlas, gl_RayFlagsTerminateOnFirstHitEXT,
                          RAYMASK_WORLD, origin, 0.0015, dir, maxDist);
    vec3 transmission = vec3(1.0);
    uint glassHits = 0u;
    uint glassVolumeFaces = 0u;
    vec3 lastGlassHalfTint = vec3(1.0);
    float waterSurfaceT = maxDist;  // nearest water surface crossed (path-traced water)
    bool causticHandoff = false;  // crossed water inside the photon window (applied once, after the loop)
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue; if (waterPatchHides(rq)) continue;  // displaced water patch
        bool alphaTestPassed;
        // `candidateEntry` is the same MaterialEntry this call already fetched internally
        MaterialEntry candidateEntry;
        if (resolveAlphaTestCandidate(rq, alphaTestPassed, candidateEntry)) {
            if (gShadeGrass && gCandidateIsGrass) continue;  // grass doesn't shadow grass, see gShadeGrass
            if (alphaTestPassed) rayQueryConfirmIntersectionEXT(rq);
            continue;
        }
        bool resolved = false;
        vec3 tint = vec3(1.0);
        float opacity = 1.0;
        {
            MaterialEntry m = candidateEntry;
            if (m.vertexAddr != 0ul && m.indexAddr != 0ul) {
                // rayQueryGetIntersectionPrimitiveIndexEXT is 0-based within this geometry
                // (geometryIndex==1), i.e
                int localPrimId = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
                uint primId = uint(localPrimId) + uint(m.albedoPad.w) / 3u;
                VertexBuf vb = VertexBuf(m.vertexAddr);
                IndexBuf ib = IndexBuf(m.indexAddr);
                uint i0 = ib.i[primId * 3 + 0];
                uint i1 = ib.i[primId * 3 + 1];
                uint i2 = ib.i[primId * 3 + 2];
                MaterialInfo mat = fetchMaterialInfo(vb.v[i0].materialIndex);
                if ((mat.flags & MATFLAG_LAVA) != 0u) { rayQueryConfirmIntersectionEXT(rq); break; }  // lava (flat tops / displaced patch) is solid
                if (gShadowWaterCaustic > 0.0 && (mat.flags & MATFLAG_WATER) != 0u) {  // this light arrives as photons
                    if (gShadowWaterCaustic >= 0.999) { rayQueryConfirmIntersectionEXT(rq); break; }
                    // once per ray, not per water candidate
                    causticHandoff = true;
                }
                vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                vec3 bary = vec3(1.0 - bc.x - bc.y, bc.x, bc.y);
                vec2 uv = vb.v[i0].uv * bary.x + vb.v[i1].uv * bary.y + vb.v[i2].uv * bary.z;
                vec3 diffuseSample;
                uint shadowTexIndex = (mat.diffuseTexIndex != 0u) ? mat.diffuseTexIndex : vb.v[i0].textureIndex;
                bool glassVolume = (mat.flags & MATFLAG_WATER) == 0u && shadowTexIndex == 0u;
                if (glassVolume) {
                    // one face of a glass volume, entry and exit each take half the tint (sqrt),
                    // nearly lossless
                    lastGlassHalfTint = sqrt(glassVolumeTint(mat.colorscale.xyz));
                    transmission *= lastGlassHalfTint * 0.96;
                    ++glassVolumeFaces;
                    if (++glassHits >= MAX_GLASS_SHADOW_HITS * 2u) { rayQueryConfirmIntersectionEXT(rq); break; }
                    continue;
                }
                if ((mat.flags & MATFLAG_WATER) != 0u) {
                    diffuseSample = mat.colorscale.xyz;
                    waterSurfaceT = min(waterSurfaceT, rayQueryGetIntersectionTEXT(rq, false));
                } else {
                    uint texIndex = (mat.diffuseTexIndex != 0u) ? mat.diffuseTexIndex : vb.v[i0].textureIndex;
                    // explicit LOD, not texture()
                    diffuseSample = pow(textureLod(uMapTextures[nonuniformEXT(texIndex)], uv, 0.0).rgb, vec3(2.2)) * mat.colorscale.xyz;
                }
                opacity = clamp(mat.glowcolor.w, 0.0, 1.0);
                // A more opaque pane both tints more strongly toward its diffuse color and blocks more
                // light overall
                if ((mat.flags & MATFLAG_WATER) == 0u) diffuseSample = mix(vec3(1.0), diffuseSample, clamp(p.glassParams.y, 0.0, 1.0));  // alpha-geometry glass tint strength
                tint = mix(vec3(1.0), diffuseSample, opacity);
                resolved = true;
            }
        }
        if (!resolved) {
            rayQueryConfirmIntersectionEXT(rq);
            continue;
        }
        transmission *= tint * (1.0 - opacity * 0.7);
        if (++glassHits >= MAX_GLASS_SHADOW_HITS || dot(transmission, transmission) < 1e-6) {
            rayQueryConfirmIntersectionEXT(rq);
            break;
        }
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) return vec3(0.0);
    if ((glassVolumeFaces & 1u) != 0u) transmission *= lastGlassHalfTint;
    if (causticHandoff) transmission *= 1.0 - gShadowWaterCaustic;
    if (any(greaterThan(gShadowWaterSigma, vec3(0.0))))
        transmission *= exp(-gShadowWaterSigma * min(waterSurfaceT, waterPlaneT(origin, dir, gShadowWaterSurfaceZ)));
    return transmission;
}

const bool RAYCONE_LOD_ENABLED = true;

float computeRayConeLodBase(vec3 p0, vec3 p1, vec3 p2, vec2 uv0, vec2 uv1, vec2 uv2,
                             float coneWidth, float cosTheta) {
    float worldArea = length(cross(p1 - p0, p2 - p0));
    vec2 uv10 = uv1 - uv0, uv20 = uv2 - uv0;
    float uvArea = abs(uv10.x * uv20.y - uv10.y * uv20.x);
    if (worldArea < 1e-9 || uvArea < 1e-12) return -100.0;
    return 0.5 * log2(uvArea / worldArea) + log2(max(coneWidth, 1e-6)) - log2(max(abs(cosTheta), 1e-4));
}

float computeRayConeLodForTexture(float lodBase, ivec2 texSize) {
    if (!RAYCONE_LOD_ENABLED) return 0.0;
    float lambda = lodBase + 0.5 * log2(float(texSize.x) * float(texSize.y));
    return clamp(lambda, 0.0, floor(log2(float(max(texSize.x, texSize.y)))));
}

vec3 applyNormalMap(vec3 N, vec4 tangent, vec2 uv, uint normalTexIndex, float lod) {
    vec3 T = tangent.xyz - N * dot(tangent.xyz, N);
    float tlen = length(T);
    if (tlen < 1e-6) return N;
    T /= tlen;
    vec3 B = cross(N, T) * (tangent.w >= 0.0 ? 1.0 : -1.0);
    // MIPMAPPING for lod
    vec3 tsNormal = (gUseGrad ? textureGrad(uMapTextures[nonuniformEXT(normalTexIndex)], uv, gUvDx, gUvDy)
                              : textureLod(uMapTextures[nonuniformEXT(normalTexIndex)], uv, lod)).rgb * 2.0 - 1.0;
    return normalize(mat3(T, B, N) * tsNormal);
}

vec3 faceViewer(vec3 n, vec3 dir) {
    const float MIN_NV = 0.05;
    float nv = -dot(n, dir);
    return nv >= MIN_NV ? n : normalize(n - dir * (MIN_NV - nv));
}

// ============================================================ Direct lighting (NEE) helpers

uint sampleEmissiveIndexImportance(inout uint seed, uint count) {
    float u = randFloat(seed);
    uint lo = 0u, hi = count - 1u;
    while (lo < hi) {
        uint mid = (lo + hi) >> 1u;
        if (emissiveTriangles[mid].v2.w < u) lo = mid + 1u; else hi = mid;
    }
    return lo;
}

// samples one point on one triangle chosen by power-weighted importance instead of uniformly
#include "rt_lava.glsl"
const vec3 LAVA_NOMINAL = vec3(1.2, 0.25, 0.01);  // = WaterExtract.h kLavaNominal (light-selection weight per unit glow)
LavaSurfaceInfo lavaSurfaceP(vec3 pos, vec3 n, float glow) {
    LavaSurfaceInfo ls = lavaSurfaceS(pos, n, glow, p.lava0, p.lava1, lavaShoreFromMap(uWaveMap, p.waterMap, pos.xy));
    ls.emission = lavaTint(ls.emission, p.lavaPatch.zw);  // lava colour (lavacolour)
    return ls;
}

bool sampleEmissiveTriangle(inout uint seed, uint count, out vec3 pointOnTri, out vec3 triNormal,
                             out float area, out vec3 radiance, out float lumUnscaled) {
    uint idx = sampleEmissiveIndexImportance(seed, count);
    EmissiveTriangle t = emissiveTriangles[idx];
    vec3 v0 = t.v0.xyz, v1 = t.v1.xyz, v2 = t.v2.xyz;
    float r1 = randFloat(seed);
    float r2 = randFloat(seed);
    float su0 = sqrt(r1);
    float b0 = 1.0 - su0;
    float b1 = r2 * su0;
    float b2 = 1.0 - b0 - b1;
    pointOnTri = b0 * v0 + b1 * v1 + b2 * v2;
    vec3 edge1 = v1 - v0, edge2 = v2 - v0;
    vec3 cr = cross(edge1, edge2);
    float len = length(cr);
    area = 0.5 * len;
    triNormal = len > 1e-8 ? cr / len : vec3(0.0, 0.0, 1.0);
    lumUnscaled = luminance(t.radiance.xyz);
    radiance = t.radiance.xyz * p.ambientFloorPad.w;
    if (t.radiance.w > 0.5)
        radiance = lavaSurfaceP(pointOnTri, triNormal, t.radiance.x / LAVA_NOMINAL.x).emission * p.ambientFloorPad.w;
    return area > 1e-8;
}

bool gPomApply = false;  // set only around the primary hit's attribute fetch
float gHitEnvRefl = 0.0;
float gHitRoughOverride = -1.0;
float gHitSpecWeight = 1.0;  // a surface's own specular scale (rough basalt crust barely shines)
// the last fetched hit's emission came from a model's glow mask (mdlptemissive)
bool gHitModelEmission = false;
float gHitLavaGlow = 0.0;
// true while shading a glowing model's surface, see accumulatePointLight()
bool gShadeSelfEmitter = false;
bool gHitIsDynamic = false;
bool gPomHit = false;  // primary hit used POM, context below is valid
vec2 gPomUv;
vec3 gPomT, gPomB, gPomN;
uint gPomTex;
float gPomScale;

float pomHeight(uint tex, vec2 uv) {
    return textureLod(uMapTextures[nonuniformEXT(tex)], uv, 0.0).a;
}

vec2 pomTexcoord(vec2 uv0, vec3 viewTs, uint tex, float scale, float bias) {
    float neutral = clamp(-bias / max(scale, 1e-6), 0.0, 1.0);
    float vz = max(viewTs.z, 0.05);
    vec2 uvPerDepth = -viewTs.xy / vz * scale;  // uv change per unit of depth, going into the surface
    float maxSteps = max(p.pomParams.y, 4.0);
    float numLayers = mix(maxSteps, maxSteps * 0.25, clamp(viewTs.z, 0.0, 1.0));  // more steps at grazing angles
    float layer = 1.0 / numLayers;
    vec2 uv = uv0 - uvPerDepth * (1.0 - neutral);  // top of the height field (depth 0)
    float depth = 0.0;
    float hDepth = 1.0 - pomHeight(tex, uv);
    vec2 prevUv = uv;
    float prevDepth = 0.0, prevHDepth = hDepth;
    int limit = int(numLayers) + 2;
    for (int i = 0; i < limit && depth < hDepth; ++i) {
        prevUv = uv; prevDepth = depth; prevHDepth = hDepth;
        uv += uvPerDepth * layer;
        depth += layer;
        hDepth = 1.0 - pomHeight(tex, uv);
    }
    // interpolate between the last two samples (reduces stair-stepping)
    float above = prevHDepth - prevDepth;
    float below = hDepth - depth;
    float w = clamp(above / max(above - below, 1e-6), 0.0, 1.0);
    vec2 result = mix(prevUv, uv, w);
    return any(isnan(result)) ? uv0 : result;
}

// QuadtreePOM (Remix's second variant)
vec2 pomTexcoordQuadtree(vec2 uv0, vec3 viewTs, uint htex, uint ntex, float scale, float bias) {
    float neutral = clamp(-bias / max(scale, 1e-6), 0.0, 1.0);
    float vz = max(viewTs.z, 0.05);
    vec2 dUV = -viewTs.xy / vz * scale;  // uv per unit of depth (depth 0 = top of the field)
    vec2 uvTop = uv0 - dUV * (1.0 - neutral);
    ivec2 size0 = textureSize(uMapTextures[nonuniformEXT(htex)], 0);
    int maxLevel = textureQueryLevels(uMapTextures[nonuniformEXT(htex)]) - 1;
    int level = maxLevel;
    float t = 0.0;
    int maxIter = int(max(p.pomParams.y, 4.0)) * 2;
    for (int i = 0; i < maxIter && level >= 0 && t < 1.0; ++i) {
        ivec2 sz = max(size0 >> level, ivec2(1));
        vec2 szf = vec2(sz);
        vec2 pT = (uvTop + dUV * t) * szf;  // position in this level's texel space
        vec2 cell = floor(pT);
        ivec2 ci = ivec2(cell - szf * floor(cell / szf));  // wrap (repeat)
        float tSurf = 1.0 - texelFetch(uMapTextures[nonuniformEXT(htex)], ci, level).r;
        if (t >= tSurf) { --level; continue; }  // at/below this cell's highest point, refine
        vec2 d = dUV * szf;
        float tx = d.x > 1e-7 ? (cell.x + 1.0 - pT.x) / d.x : (d.x < -1e-7 ? (cell.x - pT.x) / d.x : 1e9);
        float ty = d.y > 1e-7 ? (cell.y + 1.0 - pT.y) / d.y : (d.y < -1e-7 ? (cell.y - pT.y) / d.y : 1e9);
        float tExit = t + min(tx, ty);
        if (tSurf <= tExit) { t = tSurf; --level; }
        else {
            t = tExit + 1e-3 / max(max(abs(d.x), abs(d.y)), 1e-3);
            level = min(level + 1, maxLevel);
        }
    }
    t = clamp(t, 0.0, 1.0);

    // bilinear refine
    vec2 d0 = dUV * vec2(size0);
    float window = min(1.5 / max(max(abs(d0.x), abs(d0.y)), 1e-3), 1.0);
    float tA = max(t - window, 0.0), tB = min(t + window * 0.5, 1.0);
    const int REFINE = 12;
    float stepT = (tB - tA) / float(REFINE);
    float prevT = tA;
    float prevDiff = (1.0 - pomHeight(ntex, uvTop + dUV * tA)) - tA;
    if (prevDiff <= 0.0) return uvTop + dUV * tA;
    for (int i = 1; i <= REFINE; ++i) {
        float ti = tA + stepT * float(i);
        float diff = (1.0 - pomHeight(ntex, uvTop + dUV * ti)) - ti;
        if (diff <= 0.0) {
            float w = clamp(prevDiff / max(prevDiff - diff, 1e-6), 0.0, 1.0);
            vec2 r = uvTop + dUV * mix(prevT, ti, w);
            return any(isnan(r)) ? uv0 : r;
        }
        prevT = ti; prevDiff = diff;
    }
    vec2 r = uvTop + dUV * t;
    return any(isnan(r)) ? uv0 : r;
}

float pomVisibility(vec2 uv, vec3 lightTs, uint tex, float scale) {
    if (lightTs.z <= 0.0) return 1.0;
    float maxSteps = max(p.pomParams.y, 4.0);
    float numLayers = mix(maxSteps, maxSteps * 0.25, clamp(lightTs.z, 0.0, 1.0));
    float layer = 1.0 / numLayers;
    vec2 step = lightTs.xy / max(lightTs.z, 0.05) * scale * layer;  // toward the light = out of the surface
    float depth = 1.0 - pomHeight(tex, uv);
    float vis = 1.0;
    int limit = int(numLayers) + 2;
    for (int i = 0; i < limit && depth > 0.0 && vis > 0.0; ++i) {
        uv += step;
        depth -= layer;
        float hDepth = 1.0 - pomHeight(tex, uv);
        if (hDepth < depth) vis -= (depth - hDepth) / layer;
    }
    return clamp(vis, 0.0, 1.0);
}

// height-field visibility of direction dir (world) from the primary POM point
float pomDirVisibility(vec3 dir) {
    if (!gPomHit || gBounce != 0u) return 1.0;
    vec3 ts = vec3(dot(dir, gPomT), dot(dir, gPomB), dot(dir, gPomN));
    return pomVisibility(gPomUv, ts, gPomTex, gPomScale);
}

float fresnelDielectric(float cosI, float iorFrom, float iorTo) {
    float eta = iorFrom / iorTo;
    float sin2T = eta * eta * max(0.0, 1.0 - cosI * cosI);
    if (sin2T >= 1.0) return 1.0;
    float cosT = sqrt(max(0.0, 1.0 - sin2T));
    float rs = (iorFrom * cosI - iorTo * cosT) / max(iorFrom * cosI + iorTo * cosT, 1e-6);
    float rp = (iorTo * cosI - iorFrom * cosT) / max(iorTo * cosI + iorFrom * cosT, 1e-6);
    return clamp(0.5 * (rs * rs + rp * rp), 0.0, 1.0);
}

const float CAUSTIC_NEAR = 16.0;
const uint CAUSTIC_LEVELS = 12u;
const float CAUSTIC_KERNEL_PHOTONS = 24.0;  // photons a gather kernel should hold (all batches)
vec2 causticCamXY() { return (p.invView * vec4(0.0, 0.0, 0.0, 1.0)).xy; }
float causticRange() { return max(p.causticParams.w, 8.0); }
// photons are emitted over a wider disc than the window they light
float causticEmitRange() { float R = causticRange(); return R + max(32.0, 0.5 * R); }
float causticLnK() { float R = causticEmitRange(); return log(1.0 + R * R / (CAUSTIC_NEAR * CAUSTIC_NEAR)); }
uint causticPerBatch() { uint G = uint(sqrt(max(p.causticParams.z, 0.0))); return G * G; }
// hash heads per batch
uint causticHashSize() { uint n = max(2u * causticPerBatch(), 1u << 19); return 1u << uint(findMSB(n - 1u) + 1); }
// emission pdf per unit area, at horizontal distance r from the camera (normalised over the emission
// disc)
float causticAreaPdf(float r) { return 1.0 / (PI * causticLnK() * (CAUSTIC_NEAR * CAUSTIC_NEAR + r * r)); }
float causticRadiusAt(float r) {
    float batches = float(CAUSTIC_BATCHES);
    float density = batches * float(causticPerBatch()) * causticAreaPdf(r);
    // the sharpest radius
    float sharpest = max(p.causticParams.y, 0.05) * min(1.0, sqrt(131044.0 / max(float(causticPerBatch()), 1.0)));
    return clamp(sqrt(CAUSTIC_KERNEL_PHOTONS / (PI * max(density, 1e-12))), max(sharpest, 0.03), 32.0);
}
float causticLevelF(float r) { return log2(max(r, CAUSTIC_NEAR) / CAUSTIC_NEAR); }
// a photon goes into the level nearest its distance
uint causticLevelOf(float r) { return min(uint(floor(causticLevelF(r) + 0.5)), CAUSTIC_LEVELS - 1u); }
float causticCellSizeL(uint L) { return 2.0 * causticRadiusAt(CAUSTIC_NEAR * exp2(float(L) + 0.5)); }
uint causticHashL(ivec3 c, uint L) { return (uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u ^ L * 2654435761u) & (causticHashSize() - 1u); }
uint causticKeyL(ivec3 c, uint L) { return pcgHash(uint(c.x) ^ pcgHash(uint(c.y) ^ pcgHash(uint(c.z) + 0x9E3779B9u + L * 0x85EBCA6Bu))) | 1u; }
// the photon window (a disc of radius R around the camera)
float causticWindowWeight(vec3 x) {
    if (p.causticParams.x < 0.5) return 0.0;
    float R = causticRange();
    return 1.0 - smoothstep(0.75 * R, 0.95 * R, length(x.xy - causticCamXY()));
}
bool causticWaterCandidate(rayQueryEXT rq) {
    int id = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false);
    if (id < 0 || id >= materials.length()) return false;
    MaterialEntry m = materials[id];
    if (m.vertexAddr == 0ul || m.indexAddr == 0ul) return false;
    uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false)) + uint(m.albedoPad.w) / 3u;
    VertexBuf vb = VertexBuf(m.vertexAddr);
    IndexBuf ib = IndexBuf(m.indexAddr);
    return (fetchMaterialInfo(vb.v[ib.i[prim * 3u]].materialIndex).flags & MATFLAG_WATER) != 0u;
}

// caustic irradiance at x (directLighting() units)
vec3 gatherCaustics(vec3 x, vec3 N) {
    uint validMask = uint(p.causticParams2.y);
    uint validCount = bitCount(validMask);
    if (validCount == 0u) return vec3(0.0);
    float rd = length(x.xy - causticCamXY());
    float r = causticRadiusAt(rd);
    float r2 = r * r;
    uint L0 = min(uint(floor(causticLevelF(rd))), CAUSTIC_LEVELS - 1u);
    uint L1 = min(L0 + 1u, CAUSTIC_LEVELS - 1u);
    vec3 sum = vec3(0.0);
    for (uint lv = 0u; lv < 2u; ++lv) {
        uint L = lv == 0u ? L0 : L1;
        if (lv == 1u && L1 == L0) break;
        float cs = causticCellSizeL(L);
        ivec3 lo = ivec3(floor((x - vec3(r)) / cs)), hi = ivec3(floor((x + vec3(r)) / cs));
        for (uint b = 0u; b < CAUSTIC_BATCHES; ++b) {
            if (((validMask >> b) & 1u) == 0u) continue;
            for (int cz = lo.z; cz <= hi.z; ++cz)
            for (int cy = lo.y; cy <= hi.y; ++cy)
            for (int cx = lo.x; cx <= hi.x; ++cx) {
                ivec3 c = ivec3(cx, cy, cz);
                uint key = causticKeyL(c, L);
                uint idx = causticHeads[b * causticHashSize() + causticHashL(c, L)];
                for (int guard = 0; idx != 0xFFFFFFFFu && guard < 512; ++guard) {
                    CausticPhoton ph = causticPhotons[idx];
                    if (floatBitsToUint(ph.powerKey.w) == key) {
                        vec3 d = ph.posNext.xyz - x;
                        float d2 = dot(d, d);
                        if (d2 < r2 && dot(ph.normal.xyz, N) > 0.5 && abs(dot(d, N)) < 0.5 * r)
                            sum += ph.powerKey.xyz * (1.0 - d2 / r2);
                    }
                    idx = floatBitsToUint(ph.posNext.w);
                }
            }
        }
    }
    // each batch alone is a full estimate (its photons carry flux / N)
    return sum * (2.0 / (PI * r2)) / float(validCount);
}

// unshadowed flux weight of point light li onto a glass point g (normal ng)
float causticLightWeight(uint li, vec3 g, vec3 ng) {
    vec3 tl = lightNearestPoint(lights[li].posRadius.xyz, lightHalfAxis(lights[li].colorFlags, lights[li].reserved), g) - g;
    float d = length(tl);
    if (d < 1e-3) return 0.0;
    int fb = int(lights[li].colorFlags.w + 0.5);
    bool nf = (fb & 2) != 0;
    float radius = lights[li].posRadius.w;
    if (!nf && d >= radius) return 0.0;
    float atten = nf ? 1.0 : 1.0 - d / radius;
    return luminance(lights[li].colorFlags.xyz) * atten * abs(dot(ng, tl / d));
}

// binding 26, see rt_lightgrid.glsl
#define LIGHTGRID_BINDING 26
#include "rt_lightgrid.glsl"

float pointLightPickWeight(uint li, vec3 pos, vec3 N) {
    vec3 halfAxis = lightHalfAxis(lights[li].colorFlags, lights[li].reserved);
    vec3 toLight = lightNearestPoint(lights[li].posRadius.xyz, halfAxis, pos) - pos;  // reach from the segment's nearest point
    float dist = length(toLight);
    if (dist < 1e-4 || (gShadeSelfEmitter && lightShadowGap(lights[li].colorFlags, lights[li].reserved) > 0.0)) return 0.0;  // a glowing model isn't lit by emitter lights (its own glow)
    float radius = lights[li].posRadius.w;
    bool noFalloff = (int(lights[li].colorFlags.w + 0.5) & 2) != 0;
    if (!noFalloff && dist >= radius) return 0.0;
    float NdotL = lightWeighCosine(lights[li].posRadius.xyz, halfAxis, pos, N, toLight / dist);
    if (NdotL <= 0.0) return 0.0;
    float atten = (noFalloff ? 1.0 : (1.0 - dist / radius)) * lightFacing(li, -toLight / dist);
    return luminance(lights[li].colorFlags.xyz) * atten * NdotL;
}

float pointLightSplitWeight(uint li, vec3 pos, vec3 N, vec3 V, vec3 albedo, vec3 F0, float roughness, float metalness) {
    vec3 halfAxis = lightHalfAxis(lights[li].colorFlags, lights[li].reserved);
    vec3 toLight = lightNearestPoint(lights[li].posRadius.xyz, halfAxis, pos) - pos;  // reach from the segment's nearest point
    float dist = length(toLight);
    if (dist < 1e-4 || (gShadeSelfEmitter && lightShadowGap(lights[li].colorFlags, lights[li].reserved) > 0.0)) return 0.0;  // a glowing model isn't lit by emitter lights (its own glow)
    float radius = lights[li].posRadius.w;
    bool noFalloff = (int(lights[li].colorFlags.w + 0.5) & 2) != 0;
    if (!noFalloff && dist >= radius) return 0.0;
    vec3 L = toLight / dist;
    float NdotL = lightWeighCosine(lights[li].posRadius.xyz, halfAxis, pos, N, L);
    if (NdotL <= 0.0) return 0.0;
    float atten = (noFalloff ? 1.0 : (1.0 - dist / radius)) * lightFacing(li, -L);
    float pdfUnused;
    vec3 f = evalBsdf(N, V, L, albedo, F0, roughness, metalness, pdfUnused);
    return luminance(f * lights[li].colorFlags.xyz) * atten * NdotL + 1e-12;
}

bool gLastLightVisible = false;  // did the last accumulatePointLight()'s shadow ray reach its light
void accumulatePointLight(uint li, float scale, vec3 pos, vec3 N, vec3 V, vec3 albedo, vec3 F0, float roughness, float metalness,
                          inout vec3 result, inout vec3 staticDirect, inout vec3 lmIrradiance) {
    gLastLightVisible = false;
    // the reach is measured from the segment's nearest point
    vec3 halfAxis = lightHalfAxis(lights[li].colorFlags, lights[li].reserved);
    vec3 lightPos = lightNearestPoint(lights[li].posRadius.xyz, halfAxis, pos);
    float radius = lights[li].posRadius.w;
    vec3 toLight = lightPos - pos;
    float dist = length(toLight);
    // a glowing model sits inside its light's shadow gap
    if (dist < 1e-4 || (gShadeSelfEmitter && lightShadowGap(lights[li].colorFlags, lights[li].reserved) > 0.0)) return;
    // flag bits
    int flagBits = int(lights[li].colorFlags.w + 0.5);
    bool isDynlight = (flagBits & 1) != 0;
    bool noFalloff = (flagBits & 2) != 0;
    if (!noFalloff && dist >= radius) return;
    gRayStat[8]++;
    vec3 lightDir = toLight / dist;
    if (lightWeighCosine(lights[li].posRadius.xyz, halfAxis, pos, N, lightDir) <= 0.0) return;
    float atten = (noFalloff ? 1.0 : (1.0 - dist / radius)) * lightFacing(li, -lightDir);

    // soft (penumbra) shadows
    float lightSize = lightSourceRadius(lights[li].posRadius, lights[li].colorFlags, lights[li].reserved);
    if (dot(halfAxis, halfAxis) > 1e-8) {
        // a capsule
        lightPos = lights[li].posRadius.xyz + halfAxis * (blueNoise2D(0x4000u + li).x * 2.0 - 1.0);
        lightDir = normalize(lightPos - pos);
    }
    vec3 lightTangent, lightBitangent;
    buildBasis(lightDir, lightTangent, lightBitangent);
    vec2 diskUv = blueNoise2D(8u + li);
    float diskR = lightSize * sqrt(diskUv.x);
    float diskTheta = 6.28318530718 * diskUv.y;
    vec3 jitteredLightPos = lightPos + lightTangent * (diskR * cos(diskTheta)) + lightBitangent * (diskR * sin(diskTheta));
    vec3 jitteredToLight = jitteredLightPos - pos;
    float jitteredDist = length(jitteredToLight);
    if (jitteredDist < 1e-4) return;
    lightDir = jitteredToLight / jitteredDist;
    if (dot(N, lightDir) <= 0.0) return;

    vec3 origin = pos + N * 0.02;
    if (gBounce == 0u) gRayStat[3]++; else gRayStat[4]++;  // constant indices, see flushRayStats()
    // reserved.x = the light's shadow gap
    const bool perfSkipShadow = gBounce == 0u && ((uint(p.causticParams2.w) >> 22) & 1u) != 0u;
    vec3 shadowTint = perfSkipShadow ? vec3(1.0) : traceShadowRayTinted(origin, lightDir, jitteredDist - max(lightShadowGap(lights[li].colorFlags, lights[li].reserved), 0.04)) * pomDirVisibility(lightDir);
    gLastLightVisible = dot(shadowTint, shadowTint) > 0.0;
    if (dot(shadowTint, shadowTint) > 0.0) {
        float pdfUnused;
        vec3 f = evalBsdf(N, V, lightDir, albedo, F0, roughness, metalness, pdfUnused);
        // SAUER_LIGHTMAP_OVERBRIGHT and SAUER_BRDF_PI_COMPENSATION
        float overbright = SAUER_LIGHTMAP_OVERBRIGHT * SAUER_BRDF_PI_COMPENSATION;
        vec3 lightTerm = f * dot(N, lightDir) * lights[li].colorFlags.xyz * shadowTint * overbright * atten * scale;
        if (isDynlight) result += lightTerm;
        else {
            staticDirect += lightTerm;
            lmIrradiance += dot(N, lightDir) * lights[li].colorFlags.xyz * shadowTint * atten * scale;
        }
    }
}

// skybox light (ptsky) the sky lights the scene with the skybox itself
const uint SKY_W = 64u, SKY_H = 32u, SKY_CELLS = SKY_W * SKY_H;  // keep in sync with RayTracingScene::kSkyCdfCells
layout(std430, set = 0, binding = 30) buffer SkyCdfBuf {
    vec4 skyHeader;
    float skyCdf[];  // inclusive, normalized cumulative cell probability
};
vec3 sampleRealSky(vec3 dir);
// sky-local (the skybox texture's frame) <-> world
vec3 skyLocalToWorld(vec3 d) { float c = cos(p.skyRotationPad.x), s = sin(p.skyRotationPad.x); return vec3(d.x * c - d.y * s, d.x * s + d.y * c, d.z); }
vec3 skyWorldToLocal(vec3 d) { float c = cos(p.skyRotationPad.x), s = sin(p.skyRotationPad.x); return vec3(d.x * c + d.y * s, -d.x * s + d.y * c, d.z); }
vec3 skyUvToDir(vec2 uv) {
    float phi = 6.28318530718 * uv.x, z = 1.0 - 2.0 * uv.y, r = sqrt(max(0.0, 1.0 - z * z));
    return vec3(r * cos(phi), r * sin(phi), z);
}
uint skyDirToCell(vec3 d) {
    float phi = atan(d.y, d.x); if (phi < 0.0) phi += 6.28318530718;
    uint x = min(uint(phi / 6.28318530718 * float(SKY_W)), SKY_W - 1u);
    uint y = min(uint((1.0 - clamp(d.z, -1.0, 1.0)) * 0.5 * float(SKY_H)), SKY_H - 1u);
    return y * SKY_W + x;
}
bool skyLightActive() { return p.skyParams.x > 0.5 && skyHeader.w > 0.5; }
// radiance the sky lights the scene with along world direction `dir`
vec3 skyLightRadianceSkybox(vec3 dir) { return sampleRealSky(dir) * skyHeader.x; }
// solid-angle pdf of skySampleDirection() producing world direction `dir`
float skyPdf(vec3 dir) {
    uint c = skyDirToCell(skyWorldToLocal(dir));
    float prob = skyCdf[c] - (c > 0u ? skyCdf[c - 1u] : 0.0);
    return max(prob, 0.0) * skyHeader.y;
}
vec3 skySampleDirection(inout uint seed, out float pdf) {
    float u = randFloat(seed);
    uint lo = 0u, hi = SKY_CELLS - 1u;  // first cell whose cdf exceeds u
    while (lo < hi) { uint mid = (lo + hi) >> 1; if (skyCdf[mid] > u) hi = mid; else lo = mid + 1u; }
    float prob = skyCdf[lo] - (lo > 0u ? skyCdf[lo - 1u] : 0.0);
    pdf = max(prob, 0.0) * skyHeader.y;
    vec2 uv = (vec2(float(lo % SKY_W), float(lo / SKY_W)) + vec2(randFloat(seed), randFloat(seed))) / vec2(float(SKY_W), float(SKY_H));
    return skyLocalToWorld(skyUvToDir(uv));
}
// true while shading a vertex no BSDF ray will continue from (the path's last bounce, a water-
// reflection hit)
bool gNoContinuation = false;

uint perfCutValue() { return (uint(p.causticParams2.w) >> 19) & 7u; }
#define PERF_CUT_DL(v) if (gBounce == 0u && perfCutValue() == (v)) { lmIrrOut = min(lmIrradiance, vec3(1.0)); return result + staticDirect; }
layout(std430, set = 0, binding = 33) buffer RestirBuf { uvec4 restirRes[]; };
const float RESTIR_MCAP = 20.0;

struct RestirReservoir { uint light; float wSum; float M; float pHat; };

void restirAdd(inout RestirReservoir r, uint li, float w, float pHat, float M, inout uint seed) {
    r.M += M;
    if (w <= 0.0) return;
    r.wSum += w;
    if (randFloat(seed) * r.wSum < w) { r.light = li; r.pHat = pHat; }
}

// merges last frame's reservoir at `src` into r when it was the same surface
void restirReuse(inout RestirReservoir r, uint src, vec3 pos, vec3 N, vec3 V, vec3 albedo, vec3 F0, float roughness, float metalness,
                 float depth, float mCap, uint lightCount, inout uint seed) {
    uvec4 q = restirRes[src];
    if (q.x == 0xFFFFFFFFu || q.x >= lightCount) return;
    vec2 md = unpackHalf2x16(q.z);
    vec3 qN = unpackSnorm4x8(q.w).xyz;
    if (dot(qN, N) < 0.9 || abs(md.y - depth) > 0.1 * depth + 0.5) return;
    float qW = uintBitsToFloat(q.y);
    float qM = min(md.x, mCap);
    float pHat = pointLightSplitWeight(q.x, pos, N, V, albedo, F0, roughness, metalness);
    restirAdd(r, q.x, pHat * qW * qM, pHat, qM, seed);
}

void restirDirect(LightList lightList, uint lightCount, vec3 pos, vec3 N, vec3 V, vec3 albedo, vec3 F0, float roughness, float metalness,
                  inout uint seed, inout vec3 result, inout vec3 staticDirect, inout vec3 lmIrradiance) {
    const uint staticSize = lightList.cellCount + lightList.globalCount;
    const uint Mc = clamp(uint(p.rrParams.w + 0.5), 1u, 32u);
    const bool importance = ((uint(p.causticParams2.w) >> 23) & 1u) != 0u && lightListHasImportance(lightList);
    RestirReservoir r = RestirReservoir(0xFFFFFFFFu, 0.0, 0.0, 0.0);
    // new candidates, the same draw as RIS (importance tables, else uniform)
    for (uint m = 0u; m < Mc; ++m) {
        float u = randFloat(seed) * float(staticSize);
        uint slot = min(uint(u), staticSize - 1u);
        float pSource = 1.0 / float(staticSize);
        if (importance && u < float(lightList.cellCount)) {
            float pdfInCell;
            slot = lightListImportancePick(lightList, u, pdfInCell);
            pSource = pdfInCell * float(lightList.cellCount) / float(staticSize);
        }
        uint li = lightListGet(lightList, slot);
        float pHat = li < lightCount ? pointLightSplitWeight(li, pos, N, V, albedo, F0, roughness, metalness) : 0.0;
        restirAdd(r, li, pHat / pSource, pHat, 1.0, seed);
    }
    ivec2 size = imageSize(uRawRadiance);
    const uint pixelCount = uint(size.x * size.y);
    const uint parity = p.frameData.x & 1u;
    const uint curBase = parity * pixelCount, prevBase = (parity ^ 1u) * pixelCount;
    vec3 camPos = (p.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    float depth = length(pos - camPos);
    if (p.frameData.z != 0u) {
        vec4 prevClip = p.prevViewProjJittered * vec4(pos, 1.0);
        if (prevClip.w > 1e-4) {
            vec2 prevUv = prevClip.xy / prevClip.w * 0.5 + 0.5;
            ivec2 prevPixel = ivec2(floor(prevUv * vec2(size)));
            float mCap = RESTIR_MCAP * float(Mc);
            if (all(greaterThanEqual(prevPixel, ivec2(0))) && all(lessThan(prevPixel, size))) {
                restirReuse(r, prevBase + uint(prevPixel.y * size.x + prevPixel.x), pos, N, V, albedo, F0, roughness, metalness, depth, mCap, lightCount, seed);
                const uint NS = min(uint(p.rrParams.z + 0.5) & 7u, 4u);
                for (uint k = 0u; k < NS; ++k) {
                    float a = randFloat(seed) * 6.28318530718, rad = 2.0 + randFloat(seed) * 14.0;
                    ivec2 q = clamp(prevPixel + ivec2(round(vec2(cos(a), sin(a)) * rad)), ivec2(0), size - 1);
                    restirReuse(r, prevBase + uint(q.y * size.x + q.x), pos, N, V, albedo, F0, roughness, metalness, depth, mCap, lightCount, seed);
                }
            }
        }
    }
    // shade the winner with one shadow ray
    float W = (r.light != 0xFFFFFFFFu && r.pHat > 0.0 && r.M > 0.0) ? r.wSum / (r.M * r.pHat) : 0.0;
    bool visible = false;
    if (W > 0.0) {
        accumulatePointLight(r.light, W, pos, N, V, albedo, F0, roughness, metalness, result, staticDirect, lmIrradiance);
        visible = gLastLightVisible;
    }
    uint idx = curBase + uint(gPixel.y * size.x + gPixel.x);
    restirRes[idx] = uvec4(r.light, floatBitsToUint(visible ? W : 0.0),
                           packHalf2x16(vec2(min(r.M, RESTIR_MCAP * float(Mc)), depth)), packSnorm4x8(vec4(N, 0.0)));
}

vec3 directLighting(vec3 pos, vec3 N, vec3 V, vec3 albedo, vec3 F0, float roughness, float metalness, inout uint seed, out vec3 lmIrrOut) {
    vec3 result = vec3(0.0);
    // Sauerbraten's lightmapper sums sun + light entities per texel as N.L * colour and clamps that
    // sum at 255
    vec3 staticDirect = vec3(0.0);
    vec3 lmIrradiance = vec3(0.0);
    gRayStat[7]++;
    gShadowWaterCaustic = gCausticGatherHere ? causticWindowWeight(pos) : 0.0;

    PROF_LAP(21);  // directLighting setup
    PERF_CUT_DL(4u)
    if (dot(p.sunColorPad.xyz, p.sunColorPad.xyz) > 0.0) {
        vec3 sunDirBase = normalize(-p.sunDirectionRadius.xyz);
        float sunAngularRadius = max(p.sunDirectionRadius.w, 1e-4);
        vec3 sunDir = jitterSunDirection(sunDirBase, sunAngularRadius, seed);
        if (dot(N, sunDir) > 0.0) {
            float pdfBsdf;
            vec3 f = evalBsdf(N, V, sunDir, albedo, F0, roughness, metalness, pdfBsdf);
            float solidAngle = max(PI * sunAngularRadius * sunAngularRadius, 1e-8);
            float pdfLight = 1.0 / solidAngle;
            if (pdfLight + pdfBsdf > 1e-10) {
                vec3 origin = pos + N * 0.02;
                // colored/attenuated, not a plain bool
                gRayStat[2]++;
                vec3 shadowTint = traceShadowRayTinted(origin, sunDir, 4096.0) * pomDirVisibility(sunDir);
                if (dot(shadowTint, shadowTint) > 0.0) {
                    vec3 sunRadiance = p.sunColorPad.xyz / solidAngle;
                    staticDirect += f * dot(N, sunDir) * sunRadiance * shadowTint * SAUER_LIGHTMAP_OVERBRIGHT * SAUER_BRDF_PI_COMPENSATION / (pdfLight + pdfBsdf);
                    lmIrradiance += dot(N, sunDir) * p.sunColorPad.xyz * shadowTint * (pdfLight / (pdfLight + pdfBsdf));
                }
            }
        }
    }

    PROF_LAP(17);
    PERF_CUT_DL(5u)
    // one importance-sampled sky direction, MIS'd against BSDF sampling
    if (skyLightActive()) {
        float pdfSky;
        vec3 skyDir = skySampleDirection(seed, pdfSky);
        float NdotL = dot(N, skyDir);
        if (NdotL > 0.0 && pdfSky > 1e-8) {
            float pdfBsdf;
            vec3 f = evalBsdf(N, V, skyDir, albedo, F0, roughness, metalness, pdfBsdf);
            if (dot(f, f) > 0.0) {
                gRayStat[2]++;
                vec3 vis = traceShadowRayTinted(pos + N * 0.02, skyDir, 65536.0) * pomDirVisibility(skyDir);
                if (dot(vis, vis) > 0.0) {
                    float denom = gNoContinuation ? pdfSky : (pdfSky + pdfBsdf);
                    result += f * NdotL * skyLightRadianceSkybox(skyDir) * vis / denom;
                }
            }
        }
    }

    PROF_LAP(18);  // sky light
    PERF_CUT_DL(6u)
    uint lightCount = p.frameData.w;
    LightList lightList = lightListAt(pos, lightCount);
    uint listSize = lightListSize(lightList);
    uint kBegin = 0u, kEnd = listSize;
    float lightPickScale = 1.0;
    // RIS (optional, ptris light word bit 9)
    const uint risWord = uint(p.causticParams2.w);
    const uint restirMinLights = p.rrParams.y > 0.5 ? uint(p.rrParams.y + 0.5) - 1u : 0xFFFFFFFFu;
    const bool restirHere = p.rrParams.y > 0.5 && lightList.cellCount + lightList.globalCount > restirMinLights;
    if (gBounce == 0u && gSample == 0u && restirHere &&
        lightList.cellCount + lightList.globalCount > uint(p.rrParams.w + 0.5) + (uint(p.rrParams.z + 0.5) & 7u) + 1u) {
        restirDirect(lightList, lightCount, pos, N, V, albedo, F0, roughness, metalness, seed, result, staticDirect, lmIrradiance);
        gRayStat[10] += uint(p.rrParams.w + 0.5) + (uint(p.rrParams.z + 0.5) & 7u) + 1u + lightList.dynCount;
        for (uint k = lightList.cellCount + lightList.globalCount; k < listSize; ++k) {
            uint li = lightListGet(lightList, k);
            if (li < lightCount) accumulatePointLight(li, 1.0, pos, N, V, albedo, F0, roughness, metalness, result, staticDirect, lmIrradiance);
        }
        kEnd = 0u; listSize = 0u;  // done, skips RIS and the pick / split / full loops below
    }
    // only where the static list is longer than the M x NS candidates RIS would weigh
    const uint bounceWord = uint(p.rrParams.z + 0.5);
    const bool risHere = ((risWord >> 9) & 1u) != 0u || (gBounce > 0u && restirHere);
    const uint risM = gBounce > 0u ? clamp((bounceWord >> 6) & 63u, 1u, 63u) : clamp((risWord >> 10) & 63u, 1u, 63u);
    const uint risNS = gBounce > 0u ? clamp((bounceWord >> 3) & 7u, 1u, 4u) : clamp((risWord >> 16) & 7u, 1u, 4u);
    if (risHere && listSize > 0u &&
        lightList.cellCount + lightList.globalCount > risM * risNS) {
        const uint M = risM;
        const uint NS = risNS;
        const uint staticSize = lightList.cellCount + lightList.globalCount;
        // a candidate comes from the cell part (chance cellCount / staticSize) by its importance table
        const bool risImportance = ((risWord >> 23) & 1u) != 0u && lightListHasImportance(lightList);
        if (staticSize > 0u) {
            for (uint r = 0u; r < NS; ++r) {
                float wSum = 0.0, pHatPick = 0.0;
                uint pick = 0xFFFFFFFFu;
                for (uint m = 0u; m < M; ++m) {
                    float u = randFloat(seed) * float(staticSize);
                    uint slot = min(uint(u), staticSize - 1u);
                    float pSource = 1.0 / float(staticSize);
                    if (risImportance && u < float(lightList.cellCount)) {
                        float pdfInCell;
                        slot = lightListImportancePick(lightList, u, pdfInCell);
                        pSource = pdfInCell * float(lightList.cellCount) / float(staticSize);
                    }
                    uint li = lightListGet(lightList, slot);
                    if (li >= lightCount) continue;
                    float pHat = pointLightSplitWeight(li, pos, N, V, albedo, F0, roughness, metalness);
                    if (pHat <= 0.0) continue;
                    float w = pHat / pSource;  // p^ / p_source
                    wSum += w;
                    if (randFloat(seed) * wSum < w) { pick = li; pHatPick = pHat; }
                }
                if (pick != 0xFFFFFFFFu)
                    accumulatePointLight(pick, wSum / (float(M) * pHatPick * float(NS)), pos, N, V, albedo, F0, roughness, metalness, result, staticDirect, lmIrradiance);
            }
        }
        gRayStat[10] += M * NS + lightList.dynCount;  // list entries touched (ptstats)
        for (uint k = staticSize; k < listSize; ++k) {
            uint li = lightListGet(lightList, k);
            if (li < lightCount) accumulatePointLight(li, 1.0, pos, N, V, albedo, F0, roughness, metalness, result, staticDirect, lmIrradiance);
        }
        kEnd = 0u; listSize = 0u;  // done, skips the pick / split / full loops below
    }
    if ((uint(p.causticParams2.w) & 1u) != 0u && gBounce > 0u && listSize > 1u) {
        float total = 0.0;
        for (uint k = 0u; k < listSize; ++k) {
            uint li = lightListGet(lightList, k);
            if (li < lightCount) total += pointLightPickWeight(li, pos, N);
        }
        gRayStat[10] += listSize;
        kEnd = 0u;  // nothing reaches this point
        if (total > 0.0) {
            float u = randFloat(seed) * total, acc = 0.0, wPick = 0.0;
            uint pickK = 0u;
            for (uint k = 0u; k < listSize; ++k) {
                uint li = lightListGet(lightList, k);
                if (li >= lightCount) continue;
                float w = pointLightPickWeight(li, pos, N);
                if (w <= 0.0) continue;
                acc += w; pickK = k; wPick = w;
                if (u < acc) break;
            }
            if (wPick > 0.0) { kBegin = pickK; kEnd = pickK + 1u; lightPickScale = total / wPick; }
        }
    } else {
        gRayStat[10] += listSize;
    }
    // light splitting (ptlightexact K / ptlightrandom S)
    const uint lightWord = uint(p.causticParams2.w);
    const uint splitK = min((lightWord >> 1) & 15u, 8u), splitS = (lightWord >> 5) & 15u;
    if (gBounce == 0u && splitS > 0u && kBegin == 0u && kEnd == listSize && listSize > splitK + splitS) {
        uint topK[8];
        float topW[8];
        for (uint i = 0u; i < 8u; ++i) { topK[i] = 0xFFFFFFFFu; topW[i] = 0.0; }
        float totalW = 0.0;
        uint positive = 0u;
        for (uint k = 0u; k < listSize; ++k) {
            uint li = lightListGet(lightList, k);
            if (li >= lightCount) continue;
            float w = pointLightSplitWeight(li, pos, N, V, albedo, F0, roughness, metalness);
            if (w <= 0.0) continue;
            ++positive;
            if ((int(lights[li].colorFlags.w + 0.5) & 1) != 0) continue;
            totalW += w;
            // keep the K largest
            uint minSlot = 0u;
            for (uint i = 1u; i < splitK; ++i) if (topW[i] < topW[minSlot]) minSlot = i;
            if (splitK > 0u && w > topW[minSlot]) { topW[minSlot] = w; topK[minSlot] = k; }
        }
        float tailW = totalW;
        uint ranked = 0u;
        for (uint i = 0u; i < splitK; ++i) if (topK[i] != 0xFFFFFFFFu) { tailW -= topW[i]; ++ranked; }
        const bool sampleTail = tailW > 0.0 && positive > ranked + splitS;
        const float stride = tailW / float(max(splitS, 1u));
        float nextPick = randFloat(seed) * stride, acc = 0.0;
        for (uint k = 0u; k < listSize; ++k) {
            uint li = lightListGet(lightList, k);
            if (li >= lightCount) continue;
            bool exact = (int(lights[li].colorFlags.w + 0.5) & 1) != 0 || !sampleTail;
            for (uint i = 0u; i < splitK; ++i) if (topK[i] == k) exact = true;
            if (exact) {
                accumulatePointLight(li, 1.0, pos, N, V, albedo, F0, roughness, metalness, result, staticDirect, lmIrradiance);
                continue;
            }
            float w = pointLightSplitWeight(li, pos, N, V, albedo, F0, roughness, metalness);
            if (w <= 0.0) continue;
            acc += w;
            uint picks = 0u;
            while (nextPick < acc && picks < splitS) { ++picks; nextPick += stride; }
            if (picks > 0u)
                accumulatePointLight(li, float(picks) * tailW / (float(splitS) * w), pos, N, V, albedo, F0, roughness, metalness, result, staticDirect, lmIrradiance);
        }
        kEnd = 0u;  // done, skip the plain loop below
    }
    for (uint k = kBegin; k < kEnd; ++k) {
        uint li = lightListGet(lightList, k);
        if (li >= lightCount) continue;
        accumulatePointLight(li, lightPickScale, pos, N, V, albedo, F0, roughness, metalness, result, staticDirect, lmIrradiance);
    }

    gShadowWaterCaustic = 0.0;
    PROF_LAP(19);  // point lights
    PERF_CUT_DL(7u)
    // one importance-chosen emissive (glow) triangle
    uint emissiveCount = uint(p.skyAmbientPad.w);
    if (emissiveCount > 0u) {
        vec3 pointOnTri, triNormal, radiance;
        float area, lumUnscaled;
        if (sampleEmissiveTriangle(seed, emissiveCount, pointOnTri, triNormal, area, radiance, lumUnscaled)) {
            vec3 toLight = pointOnTri - pos;
            float dist2 = dot(toLight, toLight);
            float dist = sqrt(dist2);
            if (dist > 1e-4) {
                vec3 L = toLight / dist;
                float NdotL = dot(N, L);
                float cosThetaLight = abs(dot(triNormal, L));
                if (NdotL > 0.0 && cosThetaLight > 1e-5) {
                    float pdfLight = lumUnscaled * dist2 / max(p.emissiveImportancePad.x * cosThetaLight, 1e-8);
                    float pdfBsdf;
                    vec3 f = evalBsdf(N, V, L, albedo, F0, roughness, metalness, pdfBsdf);
                    if (pdfLight + pdfBsdf > 1e-10) {
                        vec3 origin = pos + N * 0.02;
                        gRayStat[5]++;
                        vec3 shadowTint = traceShadowRayTinted(origin, L, dist - 0.04) * pomDirVisibility(L);
                        if (dot(shadowTint, shadowTint) > 0.0) {
                            // same balance-heuristic simplification as the sun's contribution above
                            result += f * NdotL * radiance * shadowTint / (pdfLight + pdfBsdf);
                        }
                    }
                }
            }
        }
    }

    PROF_LAP(20);  // emissive triangle
    if (p.skyRotationPad.z > 0.5) {
        vec3 capScale = min(vec3(1.0), vec3(1.0) / max(lmIrradiance, vec3(1e-6)));
        staticDirect *= capScale;
    }
    lmIrrOut = min(lmIrradiance, vec3(1.0));
    return result + staticDirect;
}

// standard octahedral normal encoding (Cigolle et al.)
vec2 octEncode(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    vec2 result = n.z >= 0.0 ? n.xy : (vec2(1.0) - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return result * 0.5 + 0.5;  // [-1,1] -> [0,1] for texture storage
}

bool fetchHitAttributes(rayQueryEXT rq, out vec3 worldPos, out vec3 normal, out vec3 albedo,
                         out float specIntensity, out float specScale, out vec3 emission, out float triArea, out float metalness,
                         out bool isGlass, out bool isWater, out float waterRefThickness, out bool entering, float coneWidthAtOrigin, float coneSpreadAngle, out float coneWidthAtHit);

// a known, ACCEPTED v1 gap
bool fetchPrimaryPrevWorldPos(rayQueryEXT rq, out vec3 prevWorldPos) {
    int instanceId = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
    if (instanceId < 0 || instanceId >= materials.length()) return false;
    MaterialEntry m = materials[instanceId];
    if (m.vertexAddr == 0ul || m.indexAddr == 0ul || m.prevVertexAddr == 0ul) return false;
    int primId = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    if (rayQueryGetIntersectionGeometryIndexEXT(rq, true) == 1) {
        primId += int(uint(m.albedoPad.w) / 3u);
    }
    IndexBuf ib = IndexBuf(m.indexAddr);
    uint i0 = ib.i[primId * 3 + 0];
    uint i1 = ib.i[primId * 3 + 1];
    uint i2 = ib.i[primId * 3 + 2];
    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    vec3 bary = vec3(1.0 - bc.x - bc.y, bc.x, bc.y);
    VertexBuf pvb = VertexBuf(m.prevVertexAddr);
    prevWorldPos = pvb.v[i0].pos * bary.x + pvb.v[i1].pos * bary.y + pvb.v[i2].pos * bary.z;
    return true;
}

vec3 sampleRealSky(vec3 dir) {
    if (p.skyFaceIndexHi.z == 0u) return p.skyAmbientPad.xyz;  // no skybox loaded for this map, same fallback this pass always had

    float theta = p.skyRotationPad.x;
    float ct = cos(-theta), st = sin(-theta);
    vec3 d = vec3(dir.x * ct - dir.y * st, dir.x * st + dir.y * ct, dir.z);

    vec3 ad = abs(d);
    uint faceIdx; float u, v, ma;
    if (ad.x >= ad.y && ad.x >= ad.z) {
        if (d.x < 0.0) { faceIdx = p.skyFaceIndexLo.x; ma = -d.x; u = 0.5 + 0.5 * (d.y / ma); v = 0.5 - 0.5 * (d.z / ma); }
        else           { faceIdx = p.skyFaceIndexLo.y; ma =  d.x; u = 0.5 - 0.5 * (d.y / ma); v = 0.5 - 0.5 * (d.z / ma); }
    } else if (ad.y >= ad.z) {
        if (d.y < 0.0) { faceIdx = p.skyFaceIndexLo.z; ma = -d.y; u = 0.5 - 0.5 * (d.x / ma); v = 0.5 - 0.5 * (d.z / ma); }
        else           { faceIdx = p.skyFaceIndexLo.w; ma =  d.y; u = 0.5 + 0.5 * (d.x / ma); v = 0.5 - 0.5 * (d.z / ma); }
    } else {
        if (d.z < 0.0) { faceIdx = p.skyFaceIndexHi.x; ma = -d.z; u = 0.5 - 0.5 * (d.y / ma); v = 0.5 - 0.5 * (d.x / ma); }
        else           { faceIdx = p.skyFaceIndexHi.y; ma =  d.z; u = 0.5 - 0.5 * (d.y / ma); v = 0.5 + 0.5 * (d.x / ma); }
    }

    if (faceIdx == 0xFFFFFFFFu) return p.skyAmbientPad.xyz;

    vec3 texel = textureLod(uMapTextures[nonuniformEXT(faceIdx)], vec2(u, v), 0.0).rgb;
    return pow(texel, vec3(2.2)) * 0.35;
}

// sky-light radiance seen along an escaping ray
vec3 skyLightRadiance(vec3 dir) {
    float scale = p.skyRotationPad.y;
    if (scale <= 0.0) return vec3(0.0);
    if (dot(p.skyAmbientPad.xyz, p.skyAmbientPad.xyz) > 0.0) return p.skyAmbientPad.xyz * SAUER_LIGHTMAP_OVERBRIGHT * scale;
    return sampleRealSky(dir) * scale;
}

bool reconstructPrimary(ivec2 pixel, ivec2 size, vec3 cameraPos, out vec3 worldPos, out vec3 normal, out vec3 albedo,
                         out float specIntensity, out float specScale, out vec3 emission, out float rawDepth, out float metalness,
                         out bool isGlass, out bool isWater, out float waterRefThickness, out bool entering, out float coneWidth,
                         out bool isDynamic, out float linearDist) {
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    // far-plane unproject to get this pixel's primary-ray direction
    vec4 clipFar = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec4 worldFar4 = p.invViewProj * clipFar;
    vec3 worldFar = worldFar4.xyz / worldFar4.w;
    vec3 rayDir = normalize(worldFar - cameraPos);
    {  // this pixel's x+1 / y+1 neighbour rays
        vec4 fx = p.invViewProj * vec4((uv + vec2(1.0 / float(size.x), 0.0)) * 2.0 - 1.0, 1.0, 1.0);
        vec4 fy = p.invViewProj * vec4((uv + vec2(0.0, 1.0 / float(size.y))) * 2.0 - 1.0, 1.0, 1.0);
        gPrimRayOrigin = cameraPos;
        gPrimDirDx = normalize(fx.xyz / fx.w - cameraPos);
        gPrimDirDy = normalize(fy.xyz / fy.w - cameraPos);
    }

    rayQueryEXT rq;
    gRayStat[1]++;
    rayQueryInitializeEXT(rq, uTlas, 0u, 0x7F, cameraPos, 0.0, rayDir, 4096.0);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue; if (waterPatchHides(rq)) continue;  // displaced water patch
        bool alphaTestPassed;
        MaterialEntry unusedCandidateEntry;
        if (resolveAlphaTestCandidate(rq, alphaTestPassed, unusedCandidateEntry)) {
            if (alphaTestPassed) rayQueryConfirmIntersectionEXT(rq);
            continue;
        }
        rayQueryConfirmIntersectionEXT(rq);
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        // sky / no world geometry along this pixel's primary ray
        rawDepth = 1.0;
        isGlass = false;
        isWater = false;
        waterRefThickness = 0.0;
        entering = true;
        coneWidth = 0.0;
        isDynamic = false;  // no primary hit at all here, dynamic or otherwise
        linearDist = 1e6;  // large sentinel
        imageStore(uPrimaryNormalOut, pixel, vec4(0.0, 0.0, 1000.0, 1000.0));
        return false;
    }

    float unusedTriArea;
    // coneWidth is 0 at the camera itself (the ray origin)
    gPomApply = true;
    gPrimaryGradRequest = true;
    gPomHit = false;
    bool primaryFetched = fetchHitAttributes(rq, worldPos, normal, albedo, specIntensity, specScale, emission, unusedTriArea, metalness, isGlass, isWater, waterRefThickness, entering,
                             0.0, p.emissiveImportancePad.y, coneWidth);
    gPomApply = false;
    gPrimaryGradRequest = false;
    if (!primaryFetched) {
        rawDepth = 1.0;
        isGlass = false;
        isWater = false;
        waterRefThickness = 0.0;
        entering = true;
        coneWidth = 0.0;
        isDynamic = false;
        linearDist = 1e6;  // same sentinel as the sky-miss case above
        imageStore(uPrimaryNormalOut, pixel, vec4(0.0, 0.0, 1000.0, 1000.0));
        return false;
    }

    // re-derive an NDC depth compatible with pathtrace_resolve.comp's existing reprojection math
    vec4 clipHit = p.viewProj * vec4(worldPos, 1.0);
    rawDepth = clipHit.w > 1e-6 ? clamp((clipHit.z / clipHit.w) * 0.5 + 0.5, 0.0, 1.0) : 1.0;
    linearDist = length(worldPos - cameraPos);

    isDynamic = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true) >= int(p.emissiveImportancePad.z);

    vec2 dynamicPrevUv = vec2(1000.0, 1000.0);
    vec3 prevWorldPos;
    if (fetchPrimaryPrevWorldPos(rq, prevWorldPos)) {
        vec4 prevClipJittered = p.prevViewProjJittered * vec4(prevWorldPos, 1.0);
        if (prevClipJittered.w > 1e-4) {
            dynamicPrevUv = prevClipJittered.xy / prevClipJittered.w * 0.5 + 0.5;
        }
    }
    vec2 encodedNormal = octEncode(normal);
    if (isWater && !isDynamic) {
        vec2 step = vec2(0.0);
        if (p.waterParams.z > 0.0 && abs(normal.z) >= 0.5 && p.waterVolume.w > 0.0) {
            // pooled over this pixel's footprint on the water (the neighbour ray's spread), at least 1
            // unit
            float footprint = linearDist * length(gPrimDirDx - rayDir) / max(abs(dot(rayDir, normal)), 0.2);
            step = -waterWaveFlow(worldPos.xy, p.waterFft, p.waterMap, waterAmp(), max(1.0, 1.5 * footprint)) * p.waterVolume.w;
        }
        imageStore(uPrimaryNormalOut, pixel, vec4(encodedNormal.x + 4.0, encodedNormal.y, step));
        return true;
    }
    if (gHitLavaGlow > 0.0 && dynamicPrevUv.x > 999.0) dynamicPrevUv = vec2(2000.0, 2000.0);
    imageStore(uPrimaryNormalOut, pixel, vec4(encodedNormal, dynamicPrevUv.x, dynamicPrevUv.y));
    return true;
}

// fetches a bounce hit's position/normal/albedo/material response
bool fetchHitAttributes(rayQueryEXT rq, out vec3 worldPos, out vec3 normal, out vec3 albedo,
                         out float specIntensity, out float specScale, out vec3 emission, out float triArea, out float metalness,
                         out bool isGlass, out bool isWater, out float waterRefThickness, out bool entering, float coneWidthAtOrigin, float coneSpreadAngle, out float coneWidthAtHit) {
    vec3 origin = rayQueryGetWorldRayOriginEXT(rq);
    vec3 dir = rayQueryGetWorldRayDirectionEXT(rq);
    float t = rayQueryGetIntersectionTEXT(rq, true);
    worldPos = origin + dir * t;
    // MIPMAPPING for the formula this feeds
    coneWidthAtHit = coneWidthAtOrigin + coneSpreadAngle * t;
    gHitEnvRefl = 0.0;
    gHitRoughOverride = -1.0;
    gHitSpecWeight = 1.0;
    gHitModelEmission = false;
    gHitLavaGlow = 0.0;
    gHitIsGrass = false;
    gHitIsDynamic = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true) >= int(p.emissiveImportancePad.z);
    gUseGrad = false;
    specIntensity = 0.0;
    specScale = 1.0;
    emission = vec3(0.0);
    triArea = 0.0;
    metalness = 0.0;
    isGlass = false;
    isWater = false;
    waterRefThickness = 0.0;
    entering = true;

    int instanceId = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
    if (instanceId < 0 || instanceId >= materials.length()) {
        normal = -dir;  // defensive fallback, faces back toward the ray, never a zero vector
        albedo = vec3(0.6);
        return true;
    }
    MaterialEntry m = materials[instanceId];
    if (m.vertexAddr == 0ul || m.indexAddr == 0ul) {
        normal = -dir;
        albedo = m.albedoPad.xyz;
        return true;
    }

    int primId = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    if (rayQueryGetIntersectionGeometryIndexEXT(rq, true) == 1) {
        primId += int(uint(m.albedoPad.w) / 3u);
    }
    VertexBuf vb = VertexBuf(m.vertexAddr);
    IndexBuf ib = IndexBuf(m.indexAddr);
    uint i0 = ib.i[primId * 3 + 0];
    uint i1 = ib.i[primId * 3 + 1];
    uint i2 = ib.i[primId * 3 + 2];
    ChunkRtVertexGpu vx0 = vb.v[i0];
    ChunkRtVertexGpu vx1 = vb.v[i1];
    ChunkRtVertexGpu vx2 = vb.v[i2];

    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    vec3 bary = vec3(1.0 - bc.x - bc.y, bc.x, bc.y);

    mat3 objectToWorldRot = mat3(rayQueryGetIntersectionObjectToWorldEXT(rq, true));
    vec3 rawNormal = normalize(objectToWorldRot * (vx0.normal * bary.x + vx1.normal * bary.y + vx2.normal * bary.z));
    // entering/exiting determination
    entering = dot(rawNormal, dir) < 0.0;
    vec3 geomNormal = rawNormal;
    if (dot(geomNormal, dir) > 0.0) geomNormal = -geomNormal;  // always face back toward the incoming ray
    vec4 tangent = vx0.tangent * bary.x + vx1.tangent * bary.y + vx2.tangent * bary.z;
    tangent.xyz = objectToWorldRot * tangent.xyz;
    vec2 uv = vx0.uv * bary.x + vx1.uv * bary.y + vx2.uv * bary.z;
    uint materialIndex = vx0.materialIndex;
    gHitIsGrass = vx0.alphaTestCutoff >= 2.0;  // path-traced grass
    MaterialInfo mat = fetchMaterialInfo(materialIndex);
    uv += mat.scroll.xy * p.waterParams.w;
    if (gPomApply) gPomHit = false;
    if (gPomApply && p.pomParams.x > 0.5 && (mat.flags & MATFLAG_PARALLAX) != 0u && mat.normalTexIndex != 0u &&
        (mat.flags & (MATFLAG_GLASS | MATFLAG_WATER)) == 0u) {
        vec3 V = -dir;
        vec3 Tn = tangent.xyz - rawNormal * dot(tangent.xyz, rawNormal);
        float tl = length(Tn);
        if (tl > 1e-6 && dot(V, rawNormal) > 0.02) {
            Tn /= tl;
            vec3 Bn = cross(rawNormal, Tn) * (tangent.w >= 0.0 ? 1.0 : -1.0);  // same frame applyNormalMap() uses
            vec3 viewTs = vec3(dot(V, Tn), dot(V, Bn), dot(V, rawNormal));
            float scale = mat.parallax.x * p.pomParams.z;
            uint heightTex = floatBitsToUint(mat.parallax.z);
            if (p.pomParams.w > 0.5 && heightTex != 0u)
                uv = pomTexcoordQuadtree(uv, viewTs, heightTex, mat.normalTexIndex, scale, mat.parallax.y * p.pomParams.z);
            else
                uv = pomTexcoord(uv, viewTs, mat.normalTexIndex, scale, mat.parallax.y * p.pomParams.z);
            gPomHit = true;
            gPomUv = uv; gPomT = Tn; gPomB = Bn; gPomN = rawNormal;
            gPomTex = mat.normalTexIndex; gPomScale = scale;
        }
    }
    // pbr light transport on colorscale.w
    metalness = mat.colorscale.w;
    gHitRoughOverride = mat.scroll.z > 0.5 ? mat.scroll.z - 1.0 : -1.0;  // roughness override
    specScale = decodeSpecScale(mat.flags);
    isGlass = (mat.flags & (MATFLAG_GLASS | MATFLAG_WATER)) != 0u;
    isWater = (mat.flags & MATFLAG_WATER) != 0u;
    waterRefThickness = isWater ? uintBitsToFloat(mat.normalTexIndex) : 0.0;

    uint texIndex = (mat.diffuseTexIndex != 0u) ? mat.diffuseTexIndex : vx0.textureIndex;
#if PATH_TRACE_DEBUG_TEXTURE_INDEX
    albedo = vec3(float(texIndex & 255u) / 255.0, float((texIndex >> 8u) & 255u) / 255.0, float((texIndex >> 16u) & 255u) / 255.0);
    normal = geomNormal;
#else
    // MIPMAPPING. Shared once per hit
    float lodBase = RAYCONE_LOD_ENABLED ? computeRayConeLodBase(vx0.pos, vx1.pos, vx2.pos, vx0.uv, vx1.uv, vx2.uv, coneWidthAtHit, dot(geomNormal, dir)) : 0.0;
    if (gPrimaryGradRequest) {
        // neighbour rays onto this triangle's plane (world space, via the instance transform)
        mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
        vec3 w0 = o2w * vec4(vx0.pos, 1.0), w1 = o2w * vec4(vx1.pos, 1.0), w2 = o2w * vec4(vx2.pos, 1.0);
        vec3 nw = cross(w1 - w0, w2 - w0);
        float ddx = dot(gPrimDirDx, nw), ddy = dot(gPrimDirDy, nw);
        if (abs(ddx) > 1e-12 && abs(ddy) > 1e-12) {
            vec3 px = gPrimRayOrigin + gPrimDirDx * (dot(w0 - gPrimRayOrigin, nw) / ddx);
            vec3 py = gPrimRayOrigin + gPrimDirDy * (dot(w0 - gPrimRayOrigin, nw) / ddy);
            float gs = p.causticParams2.z > 0.0 ? p.causticParams2.z : 1.0;
            gDBaryDx = (rtBarycentric(px, w0, w1, w2) - bary) * gs;
            gDBaryDy = (rtBarycentric(py, w0, w1, w2) - bary) * gs;
            gUvDx = gDBaryDx.x * vx0.uv + gDBaryDx.y * vx1.uv + gDBaryDx.z * vx2.uv;
            gUvDy = gDBaryDy.x * vx0.uv + gDBaryDy.y * vx1.uv + gDBaryDy.z * vx2.uv;
            gUseGrad = all(lessThan(abs(vec4(gUvDx, gUvDy)), vec4(1e4)));  // grazing-limit guard
        }
    }
    if (isGlass && !isWater && texIndex == 0u) {
        albedo = glassVolumeTint(mat.colorscale.xyz);  // see glassVolumeTint()
        specIntensity = 0.0;
    } else if (isWater || texIndex == 0u) {
        albedo = mat.colorscale.xyz;
        specIntensity = 0.0;
    } else {
        float diffuseLod = computeRayConeLodForTexture(lodBase, textureSize(uMapTextures[nonuniformEXT(texIndex)], 0));
        vec4 diffuseSample = gUseGrad ? textureGrad(uMapTextures[nonuniformEXT(texIndex)], uv, gUvDx, gUvDy)
                                      : textureLod(uMapTextures[nonuniformEXT(texIndex)], uv, diffuseLod);
        albedo = pow(diffuseSample.rgb, vec3(2.2)) * mat.colorscale.xyz;
        specIntensity = (mat.flags & MATFLAG_SPEC) != 0u ? diffuseSample.a : ((mat.flags & MATFLAG_UNIFORMSPEC) != 0u ? 1.0 : 0.0);

        uint blendMatIdx = vx0.blendMaterialIndex;
        if (blendMatIdx != 0xFFFFFFFFu) {
            float blendAlpha = vx0.blendAlpha * bary.x + vx1.blendAlpha * bary.y + vx2.blendAlpha * bary.z;
            // the blend layer's lightmap alpha
            if (vx0.blendLmTexIndex != 0u) {
                vec2 lmUv = vx0.blendLmUv * bary.x + vx1.blendLmUv * bary.y + vx2.blendLmUv * bary.z;
                blendAlpha = textureLod(uMapTextures[nonuniformEXT(vx0.blendLmTexIndex)], lmUv, 0.0).a;
            }
            if (blendAlpha > 0.001) {
                vec2 blendUv = vx0.blendUv * bary.x + vx1.blendUv * bary.y + vx2.blendUv * bary.z;
                MaterialInfo blendMat = fetchMaterialInfo(blendMatIdx);
                uint blendTexIndex = blendMat.diffuseTexIndex;
                float blendLod = computeRayConeLodForTexture(lodBase, textureSize(uMapTextures[nonuniformEXT(blendTexIndex)], 0));
                vec4 blendSample;
                if (gUseGrad) {
                    vec2 bDx = gDBaryDx.x * vx0.blendUv + gDBaryDx.y * vx1.blendUv + gDBaryDx.z * vx2.blendUv;
                    vec2 bDy = gDBaryDy.x * vx0.blendUv + gDBaryDy.y * vx1.blendUv + gDBaryDy.z * vx2.blendUv;
                    blendSample = textureGrad(uMapTextures[nonuniformEXT(blendTexIndex)], blendUv, bDx, bDy);
                } else {
                    blendSample = textureLod(uMapTextures[nonuniformEXT(blendTexIndex)], blendUv, blendLod);
                }
                vec3 blendAlbedo = pow(blendSample.rgb, vec3(2.2)) * blendMat.colorscale.xyz;
                float blendSpec = (blendMat.flags & MATFLAG_SPEC) != 0u ? blendSample.a : ((blendMat.flags & MATFLAG_UNIFORMSPEC) != 0u ? 1.0 : 0.0);
                albedo = mix(albedo, blendAlbedo, blendAlpha);
                specIntensity = mix(specIntensity, blendSpec, blendAlpha);
                specScale = mix(specScale, decodeSpecScale(blendMat.flags), blendAlpha);
            }
        }
    }

    // alpha-geometry glass (textured)
    if (isGlass && !isWater && texIndex != 0u) albedo = mix(vec3(1.0), albedo, clamp(p.glassParams.y, 0.0, 1.0));
    if ((materialIndex & 0x80000000u) != 0u && materialIndex != 0xFFFFFFFFu && texIndex != 0u) {
        float mdlSpec = float((materialIndex >> 16u) & 0xFFu) / 63.75;
        uint masksTex = materialIndex & 0xFFFFu;
        vec3 masks = masksTex != 0u ? textureLod(uMapTextures[nonuniformEXT(masksTex)], uv, 0.0).rgb : vec3(1.0, 0.0, 0.0);
        specIntensity = clamp(0.5 * mdlSpec * masks.r, 0.0, 1.0);
        // models use the fallback MaterialInfo (flags 0), whose decoded specscale is 0
        specScale = 1.0;
        if (masksTex != 0u) {
            // reflectance = masks.b * ptmodelreflect (1 = a 100% mirror)
            gHitEnvRefl = clamp(masks.b * p.glassParams.z, 0.0, 1.0);
            specIntensity = max(specIntensity, p.matParams.x > 0.5 ? masks.b * MAT_MIRROR_KS : masks.b);
            // the glow-masked parts emit albedo * mask * strength
            float emStrength = float((materialIndex >> 24u) & 0x7Fu) * 0.25;
            float glowMask = smoothstep(0.03, 0.08, masks.g) * masks.g;
            if (emStrength > 0.0 && glowMask > 0.0) {
                emission += albedo * glowMask * emStrength;
                gHitModelEmission = true;
            }
        }
    }
    normal = geomNormal;
    if ((mat.flags & MATFLAG_NORMAL) != 0u && mat.normalTexIndex != 0u) {
        float normalLod = computeRayConeLodForTexture(lodBase, textureSize(uMapTextures[nonuniformEXT(mat.normalTexIndex)], 0));
        normal = applyNormalMap(geomNormal, tangent, uv, mat.normalTexIndex, normalLod);
        normal = faceViewer(normal, dir);
    }
    if (isWater) {  // animated waves on the flat surface
        normal = waterWaveNormal(worldPos, rawNormal);
        if (dot(normal, dir) > 0.0) normal = -normal;
    }
    if ((mat.flags & MATFLAG_GLOW) != 0u && mat.glowTexIndex != 0u) {
        float glowLod = computeRayConeLodForTexture(lodBase, textureSize(uMapTextures[nonuniformEXT(mat.glowTexIndex)], 0));
        vec3 glowTexel = gUseGrad ? textureGrad(uMapTextures[nonuniformEXT(mat.glowTexIndex)], uv, gUvDx, gUvDy).rgb
                                  : textureLod(uMapTextures[nonuniformEXT(mat.glowTexIndex)], uv, glowLod).rgb;
        emission = pow(glowTexel, vec3(2.2)) * mat.glowcolor.xyz * p.ambientFloorPad.w;
        vec3 e1 = vx1.pos - vx0.pos;
        vec3 e2 = vx2.pos - vx0.pos;
        triArea = 0.5 * length(cross(e1, e2));
    }
    if ((mat.flags & MATFLAG_LAVA) != 0u) {  // see lavaSurface()
        LavaSurfaceInfo ls = lavaSurfaceP(worldPos, geomNormal, mat.glowcolor.x);
        emission = ls.emission * p.ambientFloorPad.w;
        albedo = vec3(ls.albedo);
        gHitRoughOverride = ls.roughness;
        gHitSpecWeight = ls.specWeight;
        specIntensity = 0.0;
        normal = faceViewer(ls.normal, dir);
        gHitLavaGlow = mat.glowcolor.x;
        vec3 e1 = vx1.pos - vx0.pos;
        vec3 e2 = vx2.pos - vx0.pos;
        triArea = 0.5 * length(cross(e1, e2));
    }
#endif
    return true;
}

