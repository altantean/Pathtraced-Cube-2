#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT uTlas;

// same UBO as volfog_inject.comp, only the start of it is used here
layout(std140, set = 0, binding = 1) uniform VolFogParams {
    mat4 invViewProj;
    mat4 prevViewProj;
    uvec4 frameData;
    vec4 sunDirectionRadius;
    vec4 sunColorPad;
    vec4 skyAmbientPad;
    uvec4 gridDims;
    vec4 nearFarParams;
    vec4 fogDensityParams;
    vec4 phaseAndNoise;
    vec4 camWorldPosPad;
} p;

layout(std430, set = 0, binding = 16) writeonly buffer ColumnDepthBuf { float colDepth[]; };

float visibleDist(vec3 origin, vec3 dir) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTlas, gl_RayFlagsNoneEXT, 0x7Du, origin, 0.0, dir, 1e6);  // no view models / sprites
    while (rayQueryProceedEXT(rq)) { }
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT
        ? rayQueryGetIntersectionTEXT(rq, true) : 1e30;
}

void main() {
    uvec2 col = gl_GlobalInvocationID.xy;
    uvec3 dims = p.gridDims.xyz;
    if (any(greaterThanEqual(col, dims.xy))) return;
    vec3 cam = p.camWorldPosPad.xyz;
    float far = 0.0;
    for (int k = 0; k < 9; ++k) {
        // 3x3 spread over the column, edges included so a thin gap at the border still counts
        vec2 ndc = (vec2(col) + vec2(float(k % 3), float(k / 3)) * 0.45 + 0.05) / vec2(dims.xy) * 2.0 - 1.0;
        ndc.y = -ndc.y;  // same flip as froxelCellWorldPos()
        vec4 w = p.invViewProj * vec4(ndc, 1.0, 1.0);
        vec3 dir = normalize(w.xyz / w.w - cam);
        far = max(far, visibleDist(cam, dir));
        if (far >= 1e29) break;
    }
    colDepth[col.y * dims.x + col.x] = far;
}
